# RE/MAX Collection Vintage — lead delivery configuration.
# Copy to `.env` for local dev and set the real values in Vercel
# (Production + Preview). NEVER commit real values — `.env*` is gitignored.

# --- Resend transactional email (primary lead channel) ---
# API key from the Resend dashboard (Bearer credential).
RESEND_API_KEY=
# Inbox that receives the leads (the agency mailbox).
LEAD_RECIPIENT_EMAIL=
# Verified sender on the authenticated domain
# (e.g. leads@notify.remaxcollectionvintage.pt).
LEAD_FROM_EMAIL=

# --- Novus ingest (optional, future) ---
# When both are set, leads are ALSO forwarded to the Novus ingest. Leave
# empty until the ingest endpoint exists — the site delivers via Resend alone.
NOVUS_INGEST_ENDPOINT=
NOVUS_INGEST_TOKEN=
