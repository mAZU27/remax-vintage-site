---
// /comprar — «O método de compra». Every fact, number and service on this
// page is rendered from src/content/metodo-comprar.ts (official buyer guide
// of Grupo RE/MAX Dragão). Headlines and ledes are connective only — no
// invented claims. Items flagged `confirmar: true` in the data render
// normally but carry an adjacent CONFIRMAR COM AGÊNCIA comment.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import StructureDiagram from '../components/StructureDiagram.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import {
  mandato,
  comoFunciona,
  garantias,
  tabelaMandato,
  notaFiscal,
  etapas,
  etapasNotas,
  docsFinanciamento,
  compromisso,
  vantagensRede,
  parceiros,
} from '../content/metodo-comprar';

// Hero subtitle — the exact opening sentence of mandato.porque.
const heroSubtitle = `${mandato.porque.split('.')[0]}.`;

// Thin-line icons for the three supporting notes (order matches etapasNotas:
// visit reports · credit intermediation · legal review).
const notaIcons = ['document', 'bank', 'scale'];
---
<Base
  title="O método de compra"
  description="Mandato de Comprador e Contrato Exclusivo de Comprador: como procuramos casa por si, as garantias, as doze etapas do processo e os documentos para simulação de financiamento."
>
  <!-- 1 · Hero editorial — sem CTAs -->
  <PageHero
    eyebrow="O método · Comprar"
    title='Porquê procurar a sua casa <em class="em-gold serif-it">connosco</em>.'
    subtitle={heroSubtitle}
    image="/images/porto/porto-douro-retrato.webp"
    imagePosition="center 58%"
  />

  <!-- 2 · A estrutura à volta do cliente -->
  <section class="section section--cream" id="estrutura">
    <div class="container">
      <header class="shead shead--center">
        <SectionEyebrow text="A equipa por trás de si" center />
        <h2 class="h2 shead__title" data-reveal style="--reveal-delay:80ms">
          Uma estrutura inteira a trabalhar <em class="em-gold serif-it">para si</em>.
        </h2>
        <p class="lede shead__lede" data-reveal style="--reveal-delay:160ms">
          Não trabalha com um consultor isolado — tem do seu lado uma equipa
          completa e toda a rede.
        </p>
      </header>
      <StructureDiagram />
    </div>
  </section>

  <!-- 3 · Mandato de Comprador & Contrato Exclusivo -->
  <section class="section section--navy on-navy" id="mandato">
    <div class="container container--narrow">
      <SectionEyebrow text="A representação" />
      <h2 class="h2 shead__title" data-reveal style="--reveal-delay:80ms">
        Mandato de Comprador &amp; <em class="em-gold serif-it">Contrato Exclusivo</em>.
      </h2>
      {mandato.intro.map((para, i) => (
        <p class="mand__para" data-reveal style={`--reveal-delay:${140 + i * 60}ms`}>{para}</p>
      ))}
      <blockquote class="mand__quote" data-reveal>
        <p>{mandato.formalizacao}</p>
      </blockquote>
      <p class="mand__para mand__para--close" data-reveal>{mandato.porque}</p>
    </div>
  </section>

  <!-- 4 · Como funciona — 7 passos -->
  <section class="section section--cream" id="como-funciona">
    <div class="container container--narrow">
      <header class="shead">
        <SectionEyebrow text="Passo a passo" />
        <h2 class="h2 shead__title" data-reveal style="--reveal-delay:80ms">
          Como <em class="em-gold serif-it">funciona</em>.
        </h2>
        <p class="lede shead__lede" data-reveal style="--reveal-delay:160ms">
          O Contrato Exclusivo de Comprador, na prática — em sete passos.
        </p>
      </header>
      <ol class="cfun">
        {comoFunciona.map((step, i) => (
          <li class="cfun__item" data-reveal style={`--reveal-delay:${i * 50}ms`}>
            <span class="cfun__num" aria-hidden="true">{i + 1}</span>
            <p class="cfun__text">{step}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5 · As garantias -->
  <section class="section section--ink on-navy" id="garantias">
    <div class="container">
      <header class="shead shead--center">
        <SectionEyebrow text="Para quem compra connosco" center />
        <h2 class="h2 shead__title" data-reveal style="--reveal-delay:80ms">
          As <em class="em-gold serif-it">garantias</em>.
        </h2>
        <p class="lede lede--light shead__lede" data-reveal style="--reveal-delay:160ms">
          O que assumimos perante si quando procura casa connosco.
        </p>
      </header>
      <ul class="gar">
        {garantias.map((g, i) => (
          <li class="gar__item" data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
            <span class="gar__check" aria-hidden="true"><Icon name="check" size={15} stroke={2} /></span>
            <span class="gar__text">{g}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6 · Mandato vs Contrato Exclusivo — tabela comparativa -->
  <section class="section section--cream" id="comparacao">
    <div class="container container--narrow">
      <header class="shead">
        <SectionEyebrow text="As diferenças" />
        <h2 class="h2 shead__title" data-reveal style="--reveal-delay:80ms">
          Mandato vs <em class="em-gold serif-it">Contrato Exclusivo</em>.
        </h2>
        <p class="lede shead__lede" data-reveal style="--reveal-delay:160ms">
          As duas formas de representação, lado a lado.
        </p>
      </header>

      <div class="tblwrap" data-reveal role="region" aria-label="Tabela comparativa: Mandato de Comprador e Contrato Exclusivo de Comprador" tabindex="0">
        <table class="tbl">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Tema</span></th>
              {tabelaMandato.colunas.map((c) => (
                <th scope="col">{c}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {tabelaMandato.linhas.map((l) => (
              <tr>
                <th scope="row">{l.tema}</th>
                <td>{l.mandato}</td>
                <td>{l.exclusivo}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="tbl-nota" data-reveal>{notaFiscal}</p>
    </div>
  </section>

  <!-- 7 · As etapas do processo de compra — 12 marcos -->
  <section class="section section--cream-soft" id="etapas">
    <div class="container container--narrow">
      <header class="shead shead--center">
        <SectionEyebrow text="O percurso" center />
        <h2 class="h2 shead__title" data-reveal style="--reveal-delay:80ms">
          As etapas do processo de <em class="em-gold serif-it">compra</em>.
        </h2>
        <p class="lede shead__lede" data-reveal style="--reveal-delay:160ms">
          Doze marcos, da qualificação à alteração da morada fiscal.
        </p>
      </header>

      <ol class="etp">
        {etapas.map((e, i) => (
          <li class="etp__item" data-reveal>
            <span class="etp__num" aria-hidden="true">{i + 1}</span>
            <span class="etp__label">{e}</span>
          </li>
        ))}
      </ol>

      <ul class="enotas" data-reveal>
        {etapasNotas.map((nota, i) => (
          <li class="enotas__item">
            <span class="enotas__ic" aria-hidden="true"><Icon name={notaIcons[i]} size={18} stroke={1.4} /></span>
            <p>{nota}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8 · Documentos para simulação de financiamento -->
  <section class="section section--navy on-navy" id="documentos">
    <div class="container container--narrow">
      <SectionEyebrow text="Financiamento" />
      <h2 class="h2 shead__title" data-reveal style="--reveal-delay:80ms">
        Documentos para simulação de <em class="em-gold serif-it">financiamento</em>.
      </h2>
      <p class="lede lede--light shead__lede" data-reveal style="--reveal-delay:160ms">
        Para preparar as simulações junto das instituições bancárias, reúna os
        seguintes documentos.
      </p>

      <details class="docs" data-reveal>
        <summary class="docs__summary">
          <span>Ver a lista de documentos</span>
          <span class="docs__chev" aria-hidden="true"><Icon name="chevron" size={18} stroke={1.6} /></span>
        </summary>
        <ul class="docs__list">
          {docsFinanciamento.map((doc) => (
            <li>
              <span class="docs__ic" aria-hidden="true"><Icon name="check" size={14} stroke={2} /></span>
              {doc}
            </li>
          ))}
        </ul>
      </details>
    </div>
  </section>

  <!-- 9 · O nosso compromisso -->
  <section class="section section--cream" id="compromisso">
    <div class="container container--narrow">
      <header class="shead">
        <SectionEyebrow text="A nossa parte" />
        <h2 class="h2 shead__title" data-reveal style="--reveal-delay:80ms">
          O nosso <em class="em-gold serif-it">compromisso</em>.
        </h2>
        <p class="lede shead__lede" data-reveal style="--reveal-delay:160ms">
          O que fazemos por si, do primeiro dia à escritura.
        </p>
      </header>
      <ul class="comp" data-reveal>
        {compromisso.map((c) => (
          <li>{c}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 10 · Vantagens e serviços da rede -->
  <section class="section section--warm" id="rede">
    <div class="container">
      <header class="shead shead--center">
        <SectionEyebrow text="A rede RE/MAX" center />
        <h2 class="h2 shead__title" data-reveal style="--reveal-delay:80ms">
          Vantagens e serviços da <em class="em-gold serif-it">rede</em>.
        </h2>
        <p class="lede shead__lede" data-reveal style="--reveal-delay:160ms">
          O que a dimensão da rede coloca ao serviço da sua procura.
        </p>
      </header>

      <div class="vant">
        {vantagensRede.map((v, i) => (
          <article class="vant__card" data-reveal style={`--reveal-delay:${(i % 2) * 100}ms`}>
            <h3 class="h3 vant__title">{v.title}</h3>
            <p class="vant__text">{v.text}</p>
          </article>
        ))}
      </div>

      <div class="parc" data-reveal>
        <span class="parc__label">Parceiros</span>
        <ul class="parc__grid">
          {parceiros.map((p) => (
            <li class="parc__item">
              <strong class="parc__name">{p.name}</strong>
              <p class="parc__text">{p.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 11 · Cross-link editorial para /vender -->
  <section class="section section--tight section--cream-soft xlink">
    <div class="container container--narrow xlink__inner" data-reveal>
      <p class="xlink__q">Tem um imóvel para vender?</p>
      <Button href="/vender" variant="link" arrow>Conhecer o método de venda</Button>
    </div>
  </section>

  <!-- 12 · CTA final -->
  <section class="section section--navy on-navy fecho">
    <div class="container container--narrow" style="text-align:center">
      <SectionEyebrow text="O próximo passo" center />
      <h2 class="h2 fecho__title" data-reveal style="--reveal-delay:80ms">
        Falemos da casa que <em class="em-gold serif-it">procura</em>.
      </h2>
      <p class="lede lede--light fecho__lede" data-reveal style="--reveal-delay:160ms">
        Uma conversa clara, confidencial e sem compromisso.
      </p>
      <div class="fecho__cta" data-reveal style="--reveal-delay:240ms">
        <Button href="/contacto" variant="gold" arrow>Falar com um consultor</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Section header (mirrors the homepage idiom) ---------- */
  .shead { margin-bottom: clamp(36px, 4vw, 60px); }
  .shead__title { margin-top: 16px; max-width: 24ch; }
  .shead__lede { margin-top: 18px; }
  .shead--center { text-align: center; }
  .shead--center .shead__title { margin-inline: auto; }
  .shead--center .shead__lede { margin-inline: auto; }

  /* Warm cream variant for quiet bands (same as the homepage) */
  .section--warm { background: var(--cream-warm); color: var(--ink); }

  /* ---------- 3 · Mandato & Contrato Exclusivo ---------- */
  .mand__para {
    margin: 22px 0 0; font-size: var(--fs-body-lg); line-height: 1.7;
    color: var(--white-70); max-width: 62ch; text-wrap: pretty;
  }
  .mand__quote {
    margin: clamp(36px, 4.5vw, 56px) 0 0;
    padding: clamp(6px, 1vw, 10px) 0 clamp(6px, 1vw, 10px) clamp(24px, 3vw, 44px);
    border-left: 1px solid var(--gold);
  }
  .mand__quote p {
    margin: 0; font-family: var(--font-serif); font-style: italic; font-weight: 400;
    font-size: clamp(20px, 2.1vw, 27px); line-height: 1.5; letter-spacing: -0.01em;
    color: var(--cream); max-width: 46ch; text-wrap: pretty;
  }
  .mand__para--close { margin-top: clamp(36px, 4.5vw, 56px); color: var(--white-90); }

  /* ---------- 4 · Como funciona — numbered vertical list ---------- */
  .cfun { list-style: none; margin: 0; padding: 0; max-width: 820px; }
  .cfun__item {
    display: flex; gap: clamp(18px, 2.4vw, 30px); align-items: flex-start;
    padding-block: clamp(20px, 2.4vw, 30px);
    border-bottom: 1px solid var(--ink-10);
  }
  .cfun__item:first-child { border-top: 1px solid var(--ink-10); }
  .cfun__num {
    flex-shrink: 0; width: 44px; height: 44px; display: grid; place-items: center;
    border-radius: 50%; border: 1px solid var(--hairline-gold);
    font-family: var(--font-serif); font-size: 19px; color: var(--gold-deep);
  }
  .cfun__text {
    margin: 0; padding-top: 9px; font-size: 16px; line-height: 1.65;
    color: var(--ink-60); max-width: 62ch; text-wrap: pretty;
  }

  /* ---------- 5 · Garantias — check grid on ink ---------- */
  .gar {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: clamp(14px, 1.6vw, 22px);
    max-width: 1180px; margin-inline: auto;
  }
  .gar__item {
    display: flex; gap: 14px; align-items: flex-start;
    padding: clamp(18px, 2vw, 26px);
    border: 1px solid var(--hairline-light); border-radius: var(--radius-lg);
    background: var(--navy);
  }
  .gar__check {
    flex-shrink: 0; width: 30px; height: 30px; display: grid; place-items: center;
    border-radius: 50%; border: 1px solid var(--hairline-gold);
    color: var(--gold-light); margin-top: 1px;
  }
  .gar__text { font-size: 15px; line-height: 1.55; color: var(--white-90); }
  @media (max-width: 980px) { .gar { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .gar { grid-template-columns: 1fr; } }

  /* ---------- 6 · Tabela comparativa ---------- */
  .tblwrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-top: clamp(8px, 1vw, 16px);
  }
  .tbl { width: 100%; min-width: 720px; border-collapse: collapse; text-align: left; }
  .tbl thead th {
    font-family: var(--font-sans); font-weight: 500; font-size: 12px;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold-deep);
    padding: 0 clamp(16px, 2vw, 24px) 16px;
    border-bottom: 1px solid var(--hairline-gold-strong);
    vertical-align: bottom;
  }
  .tbl thead th:first-child { padding-left: 0; }
  .tbl tbody tr { border-bottom: 1px solid var(--ink-10); }
  .tbl tbody th {
    font-family: var(--font-serif); font-weight: 500; font-size: 17.5px;
    letter-spacing: -0.01em; color: var(--ink);
    padding: clamp(16px, 2vw, 24px) clamp(16px, 2vw, 24px) clamp(16px, 2vw, 24px) 0;
    vertical-align: top; width: 21%;
  }
  .tbl tbody td {
    padding: clamp(16px, 2vw, 24px);
    font-size: 14.5px; line-height: 1.6; color: var(--ink-60);
    vertical-align: top;
  }
  /* Quiet emphasis on the exclusive column */
  .tbl thead th:last-child, .tbl tbody td:last-child { background: var(--cream-soft); }
  .tbl-nota {
    margin: 20px 0 0; font-size: 12.5px; font-style: italic;
    letter-spacing: 0.03em; color: var(--ink-40);
  }

  /* ---------- 7 · Etapas — vertical timeline ---------- */
  .etp {
    position: relative; list-style: none; margin: 0 auto; padding: 0;
    max-width: 620px;
    display: flex; flex-direction: column; gap: clamp(22px, 2.6vw, 32px);
  }
  .etp::before {
    content: ""; position: absolute; left: 20px; top: 10px; bottom: 10px;
    width: 1px; background: var(--hairline-gold);
  }
  .etp__item { position: relative; display: flex; gap: clamp(18px, 2.4vw, 28px); align-items: flex-start; }
  .etp__num {
    position: relative; z-index: 1;
    flex-shrink: 0; width: 41px; height: 41px; display: grid; place-items: center;
    border-radius: 50%; border: 1px solid var(--hairline-gold-strong);
    background: var(--cream-soft);
    font-family: var(--font-serif); font-size: 17px; color: var(--gold-deep);
  }
  .etp__label { padding-top: 9px; font-size: 15.5px; letter-spacing: 0.01em; color: var(--ink); }

  .enotas {
    list-style: none; margin: clamp(48px, 5.5vw, 72px) auto 0;
    padding: clamp(28px, 3vw, 40px) 0 0;
    border-top: 1px solid var(--hairline-gold);
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: clamp(22px, 2.8vw, 40px);
  }
  .enotas__item { display: flex; flex-direction: column; gap: 12px; }
  .enotas__ic {
    width: 40px; height: 40px; display: grid; place-items: center;
    border: 1px solid var(--ink-20); border-radius: 50%;
    background: var(--cream); color: var(--gold-deep);
  }
  .enotas__item p { margin: 0; font-size: 13.5px; line-height: 1.6; color: var(--ink-60); text-wrap: pretty; }
  @media (max-width: 720px) { .enotas { grid-template-columns: 1fr; } }

  /* ---------- 8 · Documentos — <details> accordion ---------- */
  .docs {
    margin-top: clamp(28px, 3.4vw, 44px);
    border: 1px solid var(--hairline-light); border-radius: var(--radius-lg);
    background: var(--navy-soft);
  }
  .docs__summary {
    list-style: none;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: clamp(20px, 2.4vw, 28px) clamp(20px, 2.6vw, 32px);
    cursor: pointer;
    font-family: var(--font-serif); font-weight: 500;
    font-size: clamp(19px, 1.8vw, 24px); letter-spacing: -0.01em; color: var(--cream);
    border-radius: var(--radius-lg);
    transition: color var(--t-fast);
  }
  .docs__summary::-webkit-details-marker { display: none; }
  .docs__summary::marker { content: ""; }
  .docs__summary:hover { color: var(--gold-light); }
  .docs__chev {
    flex-shrink: 0; width: 40px; height: 40px; display: grid; place-items: center;
    border-radius: 50%; border: 1px solid var(--hairline-gold); color: var(--gold-light);
    transition: transform var(--t-med) var(--t-ease-emph), background var(--t-fast), color var(--t-fast);
  }
  .docs[open] .docs__chev {
    transform: rotate(180deg);
    background: var(--gold); border-color: var(--gold); color: var(--navy-ink);
  }
  .docs__list {
    list-style: none; margin: 0;
    padding: clamp(20px, 2.4vw, 26px) clamp(20px, 2.6vw, 32px) clamp(24px, 2.8vw, 32px);
    border-top: 1px solid var(--hairline-light);
    display: grid; grid-template-columns: 1fr 1fr; gap: 14px 40px;
  }
  .docs__list li {
    display: flex; gap: 12px; align-items: flex-start;
    font-size: 15px; line-height: 1.55; color: var(--white-90);
  }
  .docs__ic { flex-shrink: 0; color: var(--gold-light); margin-top: 4px; }
  @media (max-width: 640px) { .docs__list { grid-template-columns: 1fr; } }

  /* ---------- 9 · Compromisso — quiet two-column list ---------- */
  .comp {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(16px, 1.8vw, 22px) clamp(36px, 4vw, 64px);
  }
  .comp li {
    position: relative; padding-left: 30px;
    font-size: 15px; line-height: 1.6; color: var(--ink-60); text-wrap: pretty;
  }
  .comp li::before {
    content: ""; position: absolute; left: 0; top: 0.75em;
    width: 16px; height: 1px; background: var(--gold);
  }
  @media (max-width: 720px) { .comp { grid-template-columns: 1fr; } }

  /* ---------- 10 · Vantagens da rede + parceiros ---------- */
  .vant {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(16px, 2vw, 28px);
    max-width: 1080px; margin-inline: auto;
  }
  .vant__card {
    border: 1px solid var(--ink-10); border-radius: var(--radius-lg);
    background: var(--cream-soft);
    padding: clamp(24px, 2.8vw, 38px);
  }
  .vant__title { max-width: 24ch; }
  .vant__text { margin: 12px 0 0; font-size: 14.5px; line-height: 1.6; color: var(--ink-60); max-width: 52ch; }
  @media (max-width: 720px) { .vant { grid-template-columns: 1fr; } }

  .parc { max-width: 1080px; margin: clamp(48px, 5.5vw, 76px) auto 0; }
  .parc__label {
    display: block; font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase;
    font-weight: 500; color: var(--gold-deep);
  }
  .parc__grid {
    list-style: none; margin: 18px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: clamp(20px, 2.4vw, 36px);
  }
  .parc__item { border-top: 1px solid var(--hairline-gold); padding-top: 18px; }
  .parc__name { display: block; font-size: 15px; font-weight: 500; letter-spacing: 0.01em; color: var(--ink); }
  .parc__text { margin: 8px 0 0; font-size: 13.5px; line-height: 1.55; color: var(--ink-60); }
  @media (max-width: 980px) { .parc__grid { grid-template-columns: 1fr 1fr; } }
