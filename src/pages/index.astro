---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import HeroMobile from '../components/HeroMobile.astro';
import MobileValuationSheet from '../components/MobileValuationSheet.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import Neighborhoods from '../components/Neighborhoods.astro';
import StructureDiagram from '../components/StructureDiagram.astro';
import Stats from '../components/Stats.astro';
import ValuationForm from '../components/ValuationForm.astro';
import Crest from '../components/Crest.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { about } from '../data/site';
import { EXTERNAL_LISTINGS_URL } from '../lib/site.config';
import { essenciaisComprar, miniProcessoComprar } from '../content/metodo-comprar';
import { essenciaisVender, miniProcessoVender } from '../content/metodo-vender';
import type { Faq } from '../data/faqs';

// The homepage carries EXACTLY 11 conversion CTAs (see docs/mission map):
//  #1 hero card «Avaliar o meu imóvel» → simulator modal   (primary gold)
//     · ≤560px the hero card gives way to the MobileValuationSheet
//       («Pedir avaliação» → same simulator; «Falar com um consultor» → /contacto)
//  #2 hero «Explorar a coleção» → external listings
//     · ≤560px rendered by HeroMobile («Explorar imóveis» + destaque card,
//       both → external listings)
//  #3 método «Conhecer o método de compra» → /comprar
//  #4 método «Vender com o método» → /vender
//  #5 estrutura «Falar com um consultor» → /contacto
//  #6 como trabalhamos «Agendar uma conversa sem compromisso» → /contacto
//  #7 banner vendedor «Pedir estudo de mercado gratuito» → /contacto?assunto=estudo-mercado   (primary gold)
//  #8 vender «Simular o valor da minha casa» → simulator modal
//  #9 coleção «Ver imóveis disponíveis» → external listings
// #10 fecho «Iniciar conversa» → /contacto
// #11 hero «Venha trabalhar connosco» → /carreiras (recruitment; owner ask
//     2026-07-10 — quiet editorial link on both hero variants, leads flow to
//     the Novus app via CareersApplication → /api/lead)

const sellerPoints = [
  'Avaliação fundamentada no valor real do mercado do Porto.',
  'Discrição total — sem exposição desnecessária do seu imóvel.',
  'Resposta em 24 horas, sem qualquer compromisso.',
];
const homeFaqs: Faq[] = [
  {
    q: 'Como funciona a avaliação de um imóvel?',
    a: 'A avaliação é feita de forma confidencial, considerando localização, características do imóvel, estado de conservação, procura atual e referências reais do mercado.',
  },
  {
    q: 'A avaliação tem algum custo?',
    a: 'A avaliação inicial pode ser solicitada sem compromisso. Depois, a equipa acompanha o processo com total discrição.',
  },
  {
    q: 'Que tipo de imóveis fazem parte da Collection Vintage?',
    a: 'Imóveis distintos, bem localizados e com características raras, pensados para clientes que valorizam exclusividade, história e qualidade.',
  },
  {
    q: 'A RE/MAX Collection Vintage trabalha com compradores internacionais?',
    a: 'Sim. A equipa acompanha clientes nacionais e internacionais com um processo claro, discreto e personalizado.',
  },
  {
    q: 'Como posso vender o meu imóvel com a Collection Vintage?',
    a: 'Pode pedir uma avaliação inicial. Depois, a equipa analisa o imóvel, define o posicionamento e prepara uma estratégia de apresentação adequada ao mercado premium.',
  },
];
---
<Base
  overHeroNav
  heroPreload={[
    {
      href: '/media/hero-collection-1280.jpg',
      srcset: '/media/hero-collection-768.jpg 768w, /media/hero-collection-1280.jpg 1280w, /media/hero-collection-1672.jpg 1672w',
      sizes: '100vw',
      // Exact complement of the mobile preload — plain (min-width: 561px)
      // leaves fractional-zoom viewports in (560,561) with no preload at all.
      media: 'not all and (max-width: 560px)',
    },
    {
      // href = the 941w candidate: browsers without imagesrcset support
      // (old Safari) preload exactly what the <picture> will pick on 3x phones;
      // modern browsers ignore href when imagesrcset is present.
      href: '/media/hero-mobile-douro-941.webp',
      srcset: '/media/hero-mobile-douro-480.webp 480w, /media/hero-mobile-douro-720.webp 720w, /media/hero-mobile-douro-941.webp 941w',
      sizes: '100vw',
      media: '(max-width: 560px)',
    },
  ]}
>
  <!-- CTAs #1 + #2 live inside the hero (mobile: HeroMobile + valuation sheet) -->
  <Hero />
  <HeroMobile />
  <MobileValuationSheet />

  {/* Faixa de prémios da rede (AwardsBelt): removida 2026-07-10 até a agência
      aprovar por escrito prémios com nome/ano/atribuição corretos. */}

  <!-- Posicionamento -->
  <section class="section section--cream" id="sobre">
    <div class="container container--narrow" style="text-align:center">
      <SectionEyebrow text="A casa RE/MAX Collection" center />
      <h2 class="h2" data-reveal style="margin-top:18px">
        Uma curadoria de imóveis com <em class="em-gold serif-it">carácter</em>.
      </h2>
      <p class="lede" data-reveal style="--reveal-delay:120ms;margin:20px auto 0">
        Trabalhamos um número limitado de propriedades distintas no Porto — para as
        apresentar, posicionar e negociar com o cuidado que cada uma exige.
      </p>
    </div>
  </section>

  <!-- A Coleção — os imóveis vivem no site oficial RE/MAX (CTA #9) -->
  <section class="section section--navy on-navy colecao" id="colecao">
    <div class="container container--narrow" style="text-align:center">
      <SectionEyebrow text="A Coleção" center />
      <h2 class="h2 colecao__title" data-reveal style="--reveal-delay:80ms">
        Os imóveis disponíveis, no site <em class="em-gold serif-it">oficial RE/MAX</em>.
      </h2>
      <p class="lede lede--light colecao__lede" data-reveal style="--reveal-delay:160ms">
        A carteira da agência é apresentada e atualizada na página oficial da
        RE/MAX Collection Vintage, com toda a informação de cada imóvel.
      </p>
      <div class="colecao__cta" data-reveal style="--reveal-delay:240ms">
        <Button href={EXTERNAL_LISTINGS_URL} external variant="ghost" arrow>
          Ver imóveis disponíveis
        </Button>
      </div>
    </div>
  </section>

  <!-- Zonas (informativa — território e conhecimento do Porto) -->
  <Neighborhoods />

  <!-- O Método — split Comprar | Vender (CTAs #3 + #4) -->
  <section class="section section--cream metodo-split" id="caminhos">
    <div class="container">
      <header class="shead shead--center">
        <SectionEyebrow text="O método" center />
        <h2 class="h2 shead__title" data-reveal style="--reveal-delay:80ms">
          Um método para comprar.<br />Um método para <em class="em-gold serif-it">vender</em>.
        </h2>
        <p class="lede shead__lede" data-reveal style="--reveal-delay:160ms">
          O mesmo rigor, em dois percursos distintos — cada um com o seu plano,
          as suas garantias e o seu acompanhamento.
        </p>
      </header>

      <div class="msplit">
        <article class="msplit__card" data-reveal>
          <span class="msplit__tag">Comprar</span>
          <h3 class="h3 msplit__title">A sua futura casa, <em class="em-gold serif-it">procurada por nós</em>.</h3>
          <ul class="msplit__list">
            {essenciaisComprar.map((e) => (
              <li>
                <span class="msplit__ic"><Icon name={e.icon} size={19} stroke={1.4} /></span>
                <div>
                  <strong>{e.title}</strong>
                  <p>{e.text}</p>
                </div>
              </li>
            ))}
          </ul>
          <Button href="/comprar" variant="ghost-dark" arrow class="msplit__btn">
            Conhecer o método de compra
          </Button>
        </article>

        <article class="msplit__card" data-reveal style="--reveal-delay:120ms">
          <span class="msplit__tag">Vender</span>
          <h3 class="h3 msplit__title">O seu imóvel, <em class="em-gold serif-it">trabalhado a sério</em>.</h3>
          <ul class="msplit__list">
            {essenciaisVender.map((e) => (
              <li>
                <span class="msplit__ic"><Icon name={e.icon} size={19} stroke={1.4} /></span>
                <div>
                  <strong>{e.title}</strong>
                  <p>{e.text}</p>
                </div>
              </li>
            ))}
          </ul>
          <Button href="/vender" variant="ghost-dark" arrow class="msplit__btn">
            Vender com o método
          </Button>
        </article>
      </div>
    </div>
  </section>

  <!-- Estrutura — o cliente no centro, 10 pontos de apoio (CTA #5) -->
  <section class="section section--warm estrutura">
    <div class="container">
      <header class="shead shead--center">
        <SectionEyebrow text="A equipa por trás de si" center />
        <h2 class="h2 shead__title" data-reveal style="--reveal-delay:80ms">
          Uma estrutura inteira a trabalhar <em class="em-gold serif-it">para si</em>.
        </h2>
        <p class="lede shead__lede" data-reveal style="--reveal-delay:160ms">
          Não trabalha com um consultor isolado — tem do seu lado uma equipa
          completa e toda a rede.
        </p>
      </header>
      <StructureDiagram />
      <div class="estrutura__cta" data-reveal>
        <Button href="/contacto" variant="ghost-dark" arrow>Falar com um consultor</Button>
      </div>
    </div>
  </section>

  <!-- Como trabalhamos — dois percursos, 4 marcos cada (CTA #6) -->
  <section class="section section--cream" id="metodo">
    <div class="container">
      <header class="shead">
        <SectionEyebrow text="Como trabalhamos" />
        <h2 class="h2 shead__title" data-reveal style="--reveal-delay:80ms">
          Um método, do primeiro contacto à <em class="em-gold serif-it">escritura</em>.
        </h2>
      </header>

      <div class="mproc">
        <div class="mproc__row" data-reveal>
          <div class="mproc__head">
            <span class="mproc__who">Para quem compra</span>
            <a class="mproc__more" href="/comprar">Ver o processo completo <Icon name="arrow" size={13} stroke={1.8} /></a>
          </div>
          <ol class="mproc__steps">
            {miniProcessoComprar.map((step, i) => (
              <li class="mproc__step">
                <span class="mproc__num">{i + 1}</span>
                <span class="mproc__label">{step}</span>
              </li>
            ))}
          </ol>
        </div>

        <div class="mproc__row" data-reveal style="--reveal-delay:120ms">
          <div class="mproc__head">
            <span class="mproc__who">Para quem vende</span>
            <a class="mproc__more" href="/vender">Ver o processo completo <Icon name="arrow" size={13} stroke={1.8} /></a>
          </div>
          <ol class="mproc__steps">
            {miniProcessoVender.map((step, i) => (
              <li class="mproc__step">
                <span class="mproc__num">{i + 1}</span>
                <span class="mproc__label">{step}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="mproc__cta" data-reveal>
        <Button href="/contacto" variant="ghost-dark" arrow>Agendar uma conversa sem compromisso</Button>
      </div>
    </div>
  </section>

  <!-- Sobre + números -->
  <section class="section section--ink on-navy">
    <div class="container container--narrow about">
      <Crest size={54} class="about__crest" />
      <SectionEyebrow text={about.eyebrow} center />
      <h2 class="h2 about__title" data-reveal style="--reveal-delay:80ms">{about.title}</h2>
      {about.paragraphs.map((para, i) => (
        <p class="lede about__para" data-reveal style={`--reveal-delay:${140 + i * 80}ms`}>{para}</p>
      ))}
      <p class="about__sign" data-reveal style="--reveal-delay:320ms">{about.signature}</p>
    </div>
    <div class="container about__stats">
      <Stats />
    </div>
  </section>

  {/* «A força da rede» e «Testemunhos»: secções removidas 2026-07-10 — números
      não confirmados pela agência e testemunhos ilustrativos. Repor apenas com
      dados/testemunhos reais e autorizados. */}

  <!-- Banner de conversão do vendedor — estudo de mercado gratuito (CTA #7) -->
  <section class="section section--ink on-navy banner-em">
    <div class="container container--narrow" style="text-align:center">
      <SectionEyebrow text="Para quem vende" center />
      <h2 class="h2 banner-em__title" data-reveal style="--reveal-delay:80ms">
        Comece pelo estudo de mercado — <em class="em-gold serif-it">gratuito</em>.
      </h2>
      <p class="lede lede--light banner-em__lede" data-reveal style="--reveal-delay:160ms">
        Uma leitura fundamentada do valor do seu imóvel, preparada pela nossa
        equipa. Sem custos e sem compromisso.
      </p>
      <div class="banner-em__cta" data-reveal style="--reveal-delay:240ms">
        <Button href="/contacto?assunto=estudo-mercado" variant="gold" arrow>
          Pedir estudo de mercado gratuito
        </Button>
      </div>
    </div>
  </section>

  <!-- Vender / simulador (CTA #8) -->
  <section class="section section--navy on-navy" id="vender">
    <div class="container vender">
      <div class="vender__pitch">
        <SectionEyebrow text="Para quem vende" />
        <h2 class="h2 vender__title" data-reveal style="--reveal-delay:80ms">
          Quanto vale, hoje, o <em class="em-gold serif-it">seu imóvel</em>?
        </h2>
        <p class="lede shead__lede" data-reveal style="--reveal-delay:160ms">
          Peça uma avaliação confidencial e fundamentada. Sem compromisso — apenas
          uma leitura honesta do valor real do seu imóvel no mercado do Porto.
        </p>
        <ul class="vender__points" data-reveal style="--reveal-delay:240ms">
          {sellerPoints.map((point) => (
            <li><span class="vender__check"><Icon name="check" size={15} stroke={2} /></span>{point}</li>
          ))}
        </ul>
        <button type="button" class="btn-link vender__sim" data-reveal data-open-simulator style="--reveal-delay:300ms">
          <span>Simular o valor da minha casa</span><Icon name="arrow" size={14} stroke={1.8} />
        </button>
      </div>
      <div class="vender__form" data-reveal style="--reveal-delay:200ms">
        <ValuationForm />
      </div>
    </div>
  </section>

  <!-- Perguntas frequentes -->
  <section class="section section--cream" id="faq">
    <div class="container container--narrow" style="text-align:center">
      <h2 class="h2" data-reveal>Perguntas <em class="em-gold serif-it">frequentes</em></h2>
      <p class="lede" data-reveal style="--reveal-delay:120ms;margin:20px auto 0">
        Respostas claras para quem procura comprar, vender ou avaliar imóveis exclusivos no Porto.
      </p>
      <div class="faq-wrap" data-reveal style="--reveal-delay:200ms">
        <FaqAccordion items={homeFaqs} />
      </div>
    </div>
  </section>

  <!-- Contacto final (CTA #10) -->
  <section class="section section--warm fecho" id="contacto-final">
    <div class="container container--narrow" style="text-align:center">
      <SectionEyebrow text="Contacto" center />
      <h2 class="h2 fecho__title" data-reveal style="--reveal-delay:80ms">
        Falemos do seu <em class="em-gold serif-it">próximo capítulo</em>.
      </h2>
      <p class="lede fecho__lede" data-reveal style="--reveal-delay:160ms">
        Uma conversa clara, confidencial e sem compromisso — sobre comprar,
        vender ou simplesmente conhecer o valor do que é seu.
      </p>
      <div class="fecho__cta" data-reveal style="--reveal-delay:240ms">
        <Button href="/contacto" variant="ghost-dark" arrow>Iniciar conversa</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Section header */
  .shead { margin-bottom: clamp(36px, 4vw, 60px); }
  .shead__title { margin-top: 16px; max-width: 22ch; }
  .shead__lede { margin-top: 18px; }
  .shead--center { text-align: center; }
  .shead--center .shead__title { margin-inline: auto; }
  .shead--center .shead__lede { margin-inline: auto; }

  /* Warm cream variant for quiet bands */
  .section--warm { background: var(--cream-warm); }

  /* A Coleção */
  .colecao__title { margin-top: 16px; }
  .colecao__lede { margin: 20px auto 0; }
  .colecao__cta { margin-top: 32px; }

  /* O Método — split */
  .msplit {
    display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 2.6vw, 36px);
    max-width: 1080px; margin-inline: auto;
  }
  .msplit__card {
    border: 1px solid var(--ink-10); border-radius: var(--radius-lg);
    background: var(--cream-soft);
    padding: clamp(26px, 3vw, 42px);
    display: flex; flex-direction: column; align-items: flex-start;
  }
  .msplit__tag {
    font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--gold-deep); border: 1px solid var(--hairline-gold);
    border-radius: 999px; padding: 6px 14px;
  }
  .msplit__title { margin-top: 18px; }
  .msplit__list {
    list-style: none; margin: 24px 0 28px; padding: 0;
    display: flex; flex-direction: column; gap: 18px;
  }
  .msplit__list li { display: flex; gap: 14px; align-items: flex-start; }
  .msplit__ic {
    flex-shrink: 0; width: 42px; height: 42px; display: grid; place-items: center;
    border: 1px solid var(--ink-10); border-radius: 50%;
    background: var(--cream); color: var(--gold-deep);
  }
  .msplit__list strong {
    display: block; font-size: 15px; color: var(--ink); font-weight: 500;
    letter-spacing: 0.01em;
  }
  .msplit__list p { margin: 4px 0 0; font-size: 14px; line-height: 1.55; color: var(--ink-60); }
  :global(.msplit__btn) { margin-top: auto; }
  @media (max-width: 860px) {
    .msplit { grid-template-columns: 1fr; }
  }

  /* Estrutura */
  .estrutura__cta { margin-top: clamp(32px, 4vw, 48px); text-align: center; }

  /* Como trabalhamos — mini-processos */
  .mproc { display: flex; flex-direction: column; gap: clamp(28px, 3.4vw, 44px); }
  .mproc__head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
    margin-bottom: 18px; flex-wrap: wrap;
  }
  .mproc__who {
    font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-deep);
    font-weight: 500;
  }
  .mproc__more {
    display: inline-flex; align-items: center; gap: 7px;
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-60); text-decoration: none;
  }
  .mproc__more:hover { color: var(--gold-deep); }
  .mproc__more :global(.arrow) { transition: transform var(--t-fast); }
  .mproc__more:hover :global(.arrow) { transform: translateX(4px); }
  .mproc__steps {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;
  }
  .mproc__step {
    position: relative;
    display: flex; align-items: center; gap: 12px;
    border: 1px solid var(--ink-10); border-radius: var(--radius-lg);
    background: var(--cream-soft); padding: 16px 18px;
  }
  .mproc__num {
    flex-shrink: 0; width: 30px; height: 30px; display: grid; place-items: center;
    border-radius: 50%; border: 1px solid var(--hairline-gold);
    font-family: var(--font-serif); font-size: 15px; color: var(--gold-deep);
  }
  .mproc__label { font-size: 14px; color: var(--ink); letter-spacing: 0.01em; }
  .mproc__cta { margin-top: clamp(32px, 4vw, 48px); text-align: center; }
  @media (max-width: 860px) {
    .mproc__steps { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 420px) {
    .mproc__steps { grid-template-columns: 1fr; }
  }

  /* Banner estudo de mercado */
  .banner-em__title { margin-top: 16px; }
  .banner-em__lede { margin: 20px auto 0; }
  .banner-em__cta { margin-top: 32px; }

  /* Fecho */
  .fecho__title { margin-top: 16px; }
  .fecho__lede { margin: 20px auto 0; }
  .fecho__cta { margin-top: 30px; }

  /* FAQ — centre the accordion under the centred header */
  .faq-wrap { display: flex; justify-content: center; text-align: left; margin-top: clamp(40px, 5vw, 64px); }

  /* Sobre + números */
  .about { text-align: center; display: flex; flex-direction: column; align-items: center; }
  :global(.about__crest) { margin-bottom: 24px; }
  .about__title { margin-top: 16px; }
  .about__para { margin: 16px auto 0; }
  .about__sign {
    margin-top: 26px; font-family: var(--font-serif); font-style: italic; font-size: 19px;
    color: var(--gold-light); letter-spacing: -0.01em;
  }
  .about__stats { margin-top: clamp(48px, 6vw, 80px); }

  /* Vender */
  .vender { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 5vw, 80px); align-items: center; }
  .vender__title { margin-top: 16px; }
  .vender__sim { margin-top: 26px; }
  .vender__points { list-style: none; margin: 28px 0 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .vender__points li { display: flex; align-items: flex-start; gap: 13px; font-size: 15px; color: var(--white-90); }
  .vender__check {
    flex-shrink: 0; width: 24px; height: 24px; display: grid; place-items: center; border-radius: 50%;
    background: rgba(184, 153, 104, 0.16); color: var(--gold-light); margin-top: 1px;
  }
  @media (max-width: 920px) { .vender { grid-template-columns: 1fr; } }
</style>

<script>
  // "Pedir avaliação" lands the visitor on the valuation form, centred in the
  // viewport — not just snapped to the top of the (tall) #vender section, which
  // left the form sitting awkwardly below the fold.
  const centerValuation = () => {
    const form = document.querySelector<HTMLElement>('#vender .vender__form');
    if (!form) return;
    const navH =
      parseInt(getComputedStyle(document.documentElement).getPropertyValue('--nav-h'), 10) || 84;
    const rect = form.getBoundingClientRect();
    const absTop = window.scrollY + rect.top;
    const vh = window.innerHeight;
    // Form taller than the usable viewport → align its top just under the nav;
    // otherwise centre it vertically.
    const top =
      rect.height + navH + 32 >= vh ? absTop - navH - 16 : absTop - (vh - rect.height) / 2;
    window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
  };

  document.querySelectorAll<HTMLAnchorElement>('a[href$="#vender"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      history.replaceState(null, '', '#vender');
      centerValuation();
    });
  });

  // Arriving from another page with #vender already in the URL.
  if (location.hash === '#vender') {
    window.addEventListener('load', () => requestAnimationFrame(centerValuation));
  }
</script>
