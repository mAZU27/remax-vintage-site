---
import Base from '../layouts/Base.astro';
import CareersHero from '../components/CareersHero.astro';
import CareersCulture from '../components/CareersCulture.astro';
import CareersWhyJoin from '../components/CareersWhyJoin.astro';
import CareersBenefits from '../components/CareersBenefits.astro';
import CareersProcess from '../components/CareersProcess.astro';
import CareersOfficeLife from '../components/CareersOfficeLife.astro';
import CareersApplication from '../components/CareersApplication.astro';
import CareersFinalCTA from '../components/CareersFinalCTA.astro';
import IntentAnswers from '../components/IntentAnswers.astro';
import { careersFaqs } from '../data/search-intent';
---
<Base
  title="Consultor imobiliário no Porto: carreiras"
  description="Quer ser consultor imobiliário no Porto ou mudar de agência? Conheça a RE/MAX Collection Vintage, esclareça as condições e envie a sua candidatura espontânea."
  overHeroNav
>
  {/* CareersOpenRoles e CareersTeamVoices removidos 2026-07-10: a lista de
      vagas e os testemunhos da equipa eram placeholders fabricados (ver nota
      de honestidade em src/data/carreiras.ts). Repor apenas com vagas reais e
      testemunhos autorizados. */}
  <CareersHero />
  <CareersCulture />
  <CareersWhyJoin />
  <CareersBenefits />
  <CareersProcess />
  <CareersOfficeLife />
  <IntentAnswers id="perguntas-carreiras" title="Trabalhar no imobiliário no Porto: as suas perguntas" items={careersFaqs}>
    <p class="lede">Conheça <a href="/sobre-nos">a agência e a equipa</a> ou consulte a <a href="/contacto">morada no Porto</a>.</p>
  </IntentAnswers>
  <CareersApplication />
  <CareersFinalCTA />
</Base>
