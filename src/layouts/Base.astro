---
import '../styles/global.css';
import '../styles/performance.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ValueSimulator from '../components/ValueSimulator.astro';
import CustomerSupport from '../components/CustomerSupport.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Homepage sits over a dark video hero → nav starts transparent. */
  overHeroNav?: boolean;
  noindex?: boolean;
  /** og:type — 'article' for blog posts, default 'website'. */
  ogType?: string;
  /** schema.org type of this page's WebPage node (e.g. 'ContactPage', 'AboutPage'). */
  pageType?: string;
  /** Page-specific JSON-LD (object or array) rendered alongside the global graph. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Preload above-the-fold hero image(s) (LCP). Emits <link rel=preload as=image>.
   *  Accepts one entry or a list; `media` gates a preload to a viewport range
   *  (e.g. separate mobile/desktop hero files). */
  heroPreload?: HeroPreload | HeroPreload[];
}
interface HeroPreload {
  href: string;
  srcset?: string;
  sizes?: string;
  media?: string;
}
const {
  title,
  description = site.description,
  image = '/media/hero-poster.jpg',
  overHeroNav = false,
  noindex = false,
  ogType = 'website',
  pageType = 'WebPage',
  schema,
  heroPreload,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.shortName}` : `${site.name} — ${site.tagline}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
const origin = Astro.site ? Astro.site.href : '/';

// Global entity graph — agency + website. Contact details (phone/email) are
// deliberately NOT emitted while site.ts still carries launch placeholders;
// only verified facts go into structured data.
const sameAs = site.social.map((s) => s.href).filter((h) => h && h !== '#');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'RealEstateAgent',
      '@id': `${origin}#agency`,
      name: site.name,
      description: site.description,
      logo: new URL(site.logoFull, origin).href,
      image: new URL(site.logoFull, origin).href,
      url: origin,
      areaServed: 'Porto, Portugal',
      address: { '@type': 'PostalAddress', addressLocality: 'Porto', addressCountry: 'PT' },
      priceRange: '€€€€',
      foundingDate: String(site.established),
      ...(sameAs.length ? { sameAs } : {}),
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}#website`,
      name: site.name,
      url: origin,
      inLanguage: 'pt-PT',
      publisher: { '@id': `${origin}#agency` },
    },
    {
      '@type': pageType,
      url: canonical,
      name: pageTitle,
      description,
      inLanguage: 'pt-PT',
      isPartOf: { '@id': `${origin}#website` },
    },
  ],
};
const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0B1A2E" />
    <meta name="color-scheme" content="light" />

    {(heroPreload ? (Array.isArray(heroPreload) ? heroPreload : [heroPreload]) : []).map((p) => (
      <link
        rel="preload"
        as="image"
        href={p.href}
        imagesrcset={p.srcset}
        imagesizes={p.sizes}
        media={p.media}
        fetchpriority="high"
      />
    ))}

    <!-- Icons — the gold RE/MAX balloon, transparent (cut from the brand lockup).
         ?v=2 busts the old navy-tile version out of browser favicon caches. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="pt_PT" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@400;500&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {pageSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...s })} />
    ))}
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar para o conteúdo</a>
    <span id="top"></span>
    <Nav overHero={overHeroNav} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ValueSimulator />
    <CustomerSupport />

    <script>
      // Reveal-on-scroll — single observer for every [data-reveal] on the page.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll('[data-reveal]');
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                obs.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
