---
import Icon from './Icon.astro';

// Mobile-only (≤560px) seller-conversion sheet for the homepage hero.
// A non-blocking floating glass card that slides up ~3.8s after load,
// swipe-down/X dismissible (remembered per session via sessionStorage).
// Once dismissed it collapses into a small re-open pill, bottom-left —
// the AI-support fab owns the bottom-centre/right, so no collision.
// «Pedir avaliação» opens the global ValueSimulator ([data-open-simulator]
// event delegation), keeping one single valuation flow site-wide.
---
<aside class="vsheet" data-vsheet hidden aria-label="Faça a sua avaliação">
  <span class="vsheet__handle" aria-hidden="true"></span>
  <button class="vsheet__close" type="button" aria-label="Fechar" data-vsheet-close>
    <Icon name="close" size={15} stroke={1.8} />
  </button>

  <span class="vsheet__eyebrow">Para quem vende</span>
  <h2 class="vsheet__title">Faça a sua <em class="em-gold serif-it">avaliação</em>.</h2>
  <p class="vsheet__text">
    O valor real do seu imóvel no mercado do Porto — confidencial e sem compromisso.
  </p>

  <button class="vsheet__cta" type="button" data-open-simulator>
    <span>Pedir avaliação</span><Icon name="arrow" size={15} stroke={1.8} />
  </button>
  <a class="vsheet__alt" href="/contacto">Falar com um consultor</a>

  <ul class="vsheet__meta">
    <li><Icon name="clock" size={14} stroke={1.6} /> Resposta em 24h</li>
    <li><Icon name="shield-check" size={14} stroke={1.6} /> 100% confidencial</li>
  </ul>
</aside>

<button class="vsheet-pill" type="button" data-vsheet-pill hidden aria-label="Abrir avaliação de imóvel">
  <Icon name="sparkle" size={15} stroke={1.6} />
  <span>Avaliação</span>
</button>

<style is:global>
  /* Global (namespaced `vsheet`) — visibility classes are toggled at runtime. */
  .vsheet, .vsheet-pill { display: none; }

  @media (max-width: 560px) {
    .vsheet {
      position: fixed; left: 12px; right: 12px;
      /* Sits above the support fab position (centred, bottom:16, 54px tall) and
         BELOW the nav/drawer (z 1000) and the ValueSimulator overlay (z 1500),
         so the open menu and the modal always paint over it. */
      bottom: 92px; z-index: 900;
      display: flex; flex-direction: column;
      padding: 14px 18px 14px;
      max-height: calc(100svh - 110px); overflow-y: auto;
      border-radius: 24px; border: 1px solid rgba(176, 198, 230, 0.24);
      background: linear-gradient(180deg, rgba(16, 36, 61, 0.92), rgba(10, 23, 41, 0.94));
      -webkit-backdrop-filter: blur(22px) saturate(150%); backdrop-filter: blur(22px) saturate(150%);
      box-shadow:
        0 30px 70px -26px rgba(6, 13, 26, 0.9),
        inset 0 1px 0 rgba(255, 255, 255, 0.15),
        inset 0 0 26px -12px rgba(150, 185, 235, 0.3);
      color: var(--cream);
      transform: translateY(calc(100% + 120px)); opacity: 0;
      transition: transform 850ms cubic-bezier(0.2, 0.9, 0.27, 1), opacity 500ms ease;
    }
    .vsheet[hidden] { display: none; }
    .vsheet.is-in { transform: translateY(0); opacity: 1; }
    .vsheet.is-drag { transition: none; }

    .vsheet__handle {
      align-self: center; width: 38px; height: 4px; border-radius: 999px;
      background: rgba(244, 237, 222, 0.28); margin-bottom: 10px;
    }
    .vsheet__close {
      position: absolute; top: 10px; right: 10px;
      width: 36px; height: 36px; border-radius: 50%;
      display: grid; place-items: center; color: var(--white-70);
      background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(176, 198, 230, 0.18);
      transition: background var(--t-fast), color var(--t-fast);
    }
    .vsheet__close:active { background: rgba(255, 255, 255, 0.14); color: var(--cream); }

    .vsheet__eyebrow {
      font-size: 10px; letter-spacing: 0.26em; text-transform: uppercase;
      font-weight: 500; color: var(--gold-light);
    }
    .vsheet__title {
      margin: 7px 0 0; font-family: var(--font-serif); font-weight: 500;
      font-size: 23px; line-height: 1.15; letter-spacing: -0.01em; color: var(--cream);
    }
    .vsheet__title .em-gold { color: var(--gold-light); }
    .vsheet__text { margin: 7px 0 0; font-size: 13px; line-height: 1.5; color: var(--white-70); max-width: 34ch; }

    .vsheet__cta {
      margin-top: 14px; width: 100%; min-height: 52px;
      display: inline-flex; align-items: center; justify-content: center; gap: 10px;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--gold), var(--gold-light));
      color: var(--navy-ink);
      font-size: 13px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase;
      box-shadow: 0 16px 34px -16px rgba(184, 153, 104, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.35);
      transition: transform var(--t-fast);
    }
    .vsheet__cta:active { transform: scale(0.98); }
    .vsheet__cta .arrow { transition: transform var(--t-med); }
    .vsheet__cta:active .arrow { transform: translateX(3px); }

    .vsheet__alt {
      margin-top: 4px; align-self: center;
      font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--white-70); text-decoration: none;
      /* generous padding = real tap target; the hairline sits on a child-less
         inline so only the text is underlined */
      padding: 10px 10px 8px;
      border-bottom: 1px solid rgba(244, 237, 222, 0.25);
    }
    .vsheet__alt:active { color: var(--gold-light); border-color: var(--gold-light); }

    .vsheet__meta {
      list-style: none; margin: 13px 0 0; padding: 11px 0 0;
      border-top: 1px solid rgba(244, 237, 222, 0.14);
      display: flex; justify-content: center; gap: 20px;
    }
    .vsheet__meta li { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; color: var(--white-70); letter-spacing: 0.03em; }
    .vsheet__meta .icon { color: var(--gold-light); }

    /* ---------- Collapsed re-open pill ---------- */
    .vsheet-pill {
      position: fixed; left: 14px; bottom: 18px; z-index: 900;
      display: inline-flex; align-items: center; gap: 8px;
      padding: 11px 16px; border-radius: 999px;
      background: linear-gradient(180deg, rgba(16, 36, 61, 0.9), rgba(10, 23, 41, 0.92));
      -webkit-backdrop-filter: blur(18px) saturate(150%); backdrop-filter: blur(18px) saturate(150%);
      border: 1px solid rgba(212, 187, 133, 0.45); color: var(--gold-light);
      font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase;
      box-shadow: 0 18px 40px -18px rgba(6, 13, 26, 0.85), inset 0 1px 0 rgba(255, 255, 255, 0.14);
      transform: translateY(14px); opacity: 0;
      transition: transform 600ms var(--t-ease-emph), opacity 400ms ease;
    }
    .vsheet-pill[hidden] { display: none; }
    .vsheet-pill.is-in { transform: translateY(0); opacity: 1; }
    .vsheet-pill:active { transform: scale(0.96); }
    /* Very narrow phones — icon-only so it never reaches the centred support fab. */
    @media (max-width: 359px) {
      .vsheet-pill { padding: 12px; }
      .vsheet-pill span { display: none; }
    }

    /* The global :focus-visible ring squares the radius — explicit gold outline. */
    .vsheet__cta:focus-visible, .vsheet__close:focus-visible,
    .vsheet__alt:focus-visible, .vsheet-pill:focus-visible {
      outline: 2px solid var(--gold-light); outline-offset: 3px;
      box-shadow: none; border-radius: 999px;
    }
  }
</style>

<script>
  const sheet = document.querySelector<HTMLElement>('[data-vsheet]');
  const pill = document.querySelector<HTMLElement>('[data-vsheet-pill]');
  if (sheet && pill) {
    const KEY = 'rvx-vsheet-dismissed';
    const mqMobile = window.matchMedia('(max-width: 560px)');
    let hideTimer = 0;

    // sessionStorage can throw in locked-down/private contexts — degrade to
    // "not dismissed" instead of killing the whole controller.
    const wasDismissed = () => {
      try {
        return sessionStorage.getItem(KEY) === '1';
      } catch {
        return false;
      }
    };
    const rememberDismissed = () => {
      try {
        sessionStorage.setItem(KEY, '1');
      } catch {
        /* fine — the sheet just re-offers next load */
      }
    };

    const nav = document.querySelector<HTMLElement>('[data-nav]');
    const simulator = document.querySelector<HTMLElement>('[data-vsim]');
    const navIsOpen = () => nav?.hasAttribute('data-open') ?? false;
    const simulatorIsOpen = () => (simulator ? !simulator.hidden : false);

    const showPill = () => {
      pill.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => pill.classList.add('is-in')));
    };
    const hidePill = () => {
      pill.classList.remove('is-in');
      pill.hidden = true;
    };
    const showSheet = () => {
      window.clearTimeout(hideTimer);
      sheet.hidden = false;
      sheet.style.transform = '';
      requestAnimationFrame(() => requestAnimationFrame(() => sheet.classList.add('is-in')));
    };
    const hideSheet = (remember: boolean) => {
      if (remember) rememberDismissed();
      sheet.classList.remove('is-in');
      hideTimer = window.setTimeout(() => {
        // Hand keyboard/AT focus to the pill instead of dropping it on <body>.
        const hadFocus = sheet.contains(document.activeElement);
        sheet.hidden = true;
        showPill();
        if (hadFocus) pill.focus();
      }, 550);
    };

    // Auto-reveal once per session, after the hero choreography settles.
    // While the nav drawer is open the reveal re-arms instead of firing under it.
    const armAutoShow = (delay: number) => {
      window.setTimeout(() => {
        if (!mqMobile.matches || !sheet.hidden || !pill.hidden) return;
        if (wasDismissed()) return;
        if (navIsOpen()) {
          armAutoShow(3000);
          return;
        }
        showSheet();
      }, delay);
    };
    if (wasDismissed()) {
      if (mqMobile.matches) showPill();
    } else {
      armAutoShow(3800);
    }
    // Loading in landscape/desktop width and rotating into ≤560px later.
    mqMobile.addEventListener('change', (e) => {
      if (!e.matches || !sheet.hidden || !pill.hidden) return;
      if (wasDismissed()) showPill();
      else armAutoShow(600);
    });

    sheet.querySelector('[data-vsheet-close]')?.addEventListener('click', () => hideSheet(true));
    pill.addEventListener('click', () => {
      hidePill();
      showSheet();
      sheet.querySelector<HTMLButtonElement>('[data-vsheet-close]')?.focus();
    });

    // «Pedir avaliação» opens the ValueSimulator (z 1500) OVER the sheet; the
    // sheet stays put underneath so the modal's focus-restore lands on a
    // visible trigger, and only collapses once the modal closes.
    let collapseAfterSimulator = false;
    sheet.querySelector('[data-open-simulator]')?.addEventListener('click', () => {
      rememberDismissed();
      collapseAfterSimulator = true;
    });
    if (simulator) {
      new MutationObserver(() => {
        if (simulator.hidden && collapseAfterSimulator) {
          collapseAfterSimulator = false;
          if (!sheet.hidden) hideSheet(false);
        }
      }).observe(simulator, { attributes: true, attributeFilter: ['hidden'] });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      // The simulator (or the open menu) owns Escape while it is up.
      if (simulatorIsOpen() || navIsOpen()) return;
      if (!sheet.hidden && sheet.classList.contains('is-in')) hideSheet(true);
    });

    // Swipe-down to dismiss — engages only after clear downward intent, so a
    // tap never snaps the entrance/exit transition.
    let startY = 0;
    let delta = 0;
    let dragging = false;
    sheet.addEventListener(
      'touchstart',
      (e) => {
        startY = e.touches[0].clientY;
        delta = 0;
        dragging = false;
      },
      { passive: true }
    );
    sheet.addEventListener(
      'touchmove',
      (e) => {
        if (!sheet.classList.contains('is-in')) return;
        delta = Math.max(0, e.touches[0].clientY - startY);
        if (!dragging && delta > 6) {
          dragging = true;
          sheet.classList.add('is-drag');
        }
        if (dragging) sheet.style.transform = `translateY(${delta}px)`;
      },
      { passive: true }
    );
    sheet.addEventListener('touchend', () => {
      if (!dragging) return;
      dragging = false;
      sheet.classList.remove('is-drag');
      sheet.style.transform = '';
      if (delta > 70) hideSheet(true);
    });
  }
</script>
