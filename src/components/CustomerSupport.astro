---
// Floating customer-support assistant — a conversational, intent-driven chat
// widget in the Collection Vintage liquid-glass navy/gold aesthetic. Site-wide
// (mounted in Base.astro). The brain lives in src/data/support*.ts:
//   supportKnowledge.ts — real, honest content (composed from site.ts/faqs.ts)
//   supportIntents.ts   — accent-insensitive intent detection + FAQ search
//   supportResponses.ts — intent → reply + lead-capture flows
// This file is UI + a thin client controller that imports that engine.
import Icon from './Icon.astro';
---
<div class="cs" data-cs>
  <!-- Panel -->
  <div class="cs__panel" id="cs-panel" role="dialog" aria-label="Assistente Collection Vintage" aria-modal="false" hidden>
    <header class="cs__head">
      <span class="cs__avatar" aria-hidden="true"><Icon name="chat" size={22} stroke={1.5} /></span>
      <span class="cs__head-text">
        <span class="cs__title">Assistente Collection Vintage</span>
        <span class="cs__status"><span class="cs__dot" aria-hidden="true"></span> Assistente digital · sem compromisso</span>
      </span>
      <button class="cs__close" type="button" aria-label="Fechar assistente" data-cs-close>
        <Icon name="close" size={18} stroke={1.7} />
      </button>
    </header>

    <div class="cs__thread" data-cs-thread role="log" aria-live="polite" aria-label="Conversa"></div>

    <form class="cs__input" data-cs-form>
      <input
        class="cs__field"
        type="text"
        data-cs-text
        placeholder="Escreva a sua mensagem…"
        autocomplete="off"
        aria-label="Escreva a sua mensagem"
      />
      <button class="cs__send" type="submit" aria-label="Enviar mensagem">
        <Icon name="send" size={19} stroke={1.7} />
      </button>
    </form>

    <p class="cs__foot"><Icon name="shield-check" size={14} stroke={1.6} /> Confidencial em cada etapa</p>
  </div>

  <!-- Floating button -->
  <button class="cs__fab" type="button" aria-label="Abrir assistente" aria-expanded="false" aria-controls="cs-panel" data-cs-toggle>
    <span class="cs__fab-ring" aria-hidden="true"></span>
    <span class="cs__fab-icon cs__fab-icon--chat" aria-hidden="true"><Icon name="chat" size={26} stroke={1.5} /></span>
    <span class="cs__fab-icon cs__fab-icon--close" aria-hidden="true"><Icon name="close" size={24} stroke={1.8} /></span>
  </button>
</div>

<style is:global>
  /* Global (not scoped): the message/chip/CTA elements are created at runtime by
     the controller below, so they never receive Astro's [data-astro-*] scope
     attribute. Scoped rules would silently miss them. Every selector here is
     namespaced (cs / cs__*) and the widget mounts once, so global is safe. */
  .cs {
    position: fixed; right: clamp(16px, 2.4vw, 30px); bottom: clamp(16px, 2.4vw, 30px);
    z-index: 999999; display: flex; flex-direction: column; align-items: flex-end; gap: 14px;
    font-family: var(--font-sans);
  }

  /* ---------- Floating button (liquid-glass navy + gold ring) ---------- */
  .cs__fab {
    position: relative; width: 62px; height: 62px; border-radius: 50%;
    display: grid; place-items: center; cursor: pointer;
    background: radial-gradient(120% 120% at 30% 22%, rgba(26, 54, 86, 0.96), rgba(11, 26, 46, 0.96));
    border: 1px solid rgba(176, 198, 230, 0.22);
    box-shadow:
      0 18px 40px -16px rgba(6, 13, 26, 0.8),
      0 4px 14px -6px rgba(6, 13, 26, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      inset 0 0 18px -8px rgba(150, 185, 235, 0.4);
    color: var(--gold-light);
    transition: transform var(--t-fast), box-shadow var(--t-fast), border-color var(--t-fast);
  }
  .cs__fab:hover { transform: translateY(-2px); border-color: var(--hairline-gold-strong); }
  .cs__fab:active { transform: translateY(0); }

  .cs__fab-ring {
    position: absolute; inset: 4px; border-radius: 50%; pointer-events: none;
    border: 1px solid rgba(184, 153, 104, 0.55);
    box-shadow: inset 0 0 10px -4px rgba(212, 187, 133, 0.6);
  }

  .cs__fab-icon { position: absolute; line-height: 0; transition: opacity var(--t-fast), transform var(--t-fast); }
  .cs__fab-icon--close { opacity: 0; transform: scale(0.7) rotate(-30deg); }
  .cs[data-open] .cs__fab-icon--chat { opacity: 0; transform: scale(0.7) rotate(30deg); }
  .cs[data-open] .cs__fab-icon--close { opacity: 1; transform: scale(1) rotate(0); color: var(--cream); }

  .cs__fab::after {
    content: ""; position: absolute; inset: 0; border-radius: 50%; pointer-events: none;
    border: 1px solid rgba(212, 187, 133, 0.5);
    animation: cs-pulse 2.8s ease-out infinite;
  }
  .cs[data-open] .cs__fab::after { animation: none; opacity: 0; }
  @keyframes cs-pulse {
    0% { transform: scale(1); opacity: 0.6; }
    70% { transform: scale(1.45); opacity: 0; }
    100% { transform: scale(1.45); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .cs__fab::after { animation: none; opacity: 0; } }

  /* ---------- Panel (liquid-glass card) ---------- */
  .cs__panel {
    display: flex; flex-direction: column;
    width: min(386px, calc(100vw - 28px));
    height: min(582px, calc(100svh - 112px));
    background: linear-gradient(180deg, rgba(16, 36, 61, 0.92), rgba(10, 23, 41, 0.9));
    -webkit-backdrop-filter: blur(22px) saturate(150%); backdrop-filter: blur(22px) saturate(150%);
    border: 1px solid rgba(176, 198, 230, 0.22);
    border-radius: 22px;
    box-shadow:
      0 34px 80px -30px rgba(6, 13, 26, 0.88),
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      inset 0 0 28px -12px rgba(150, 185, 235, 0.3);
    overflow: hidden;
    z-index: 999998;
    transform-origin: bottom right; transform: translateY(10px) scale(0.96); opacity: 0;
    transition: transform var(--t-med), opacity var(--t-med);
  }
  .cs__panel[hidden] { display: none !important; }
  .cs[data-open] .cs__panel { transform: translateY(0) scale(1); opacity: 1; }

  /* ---------- Header ---------- */
  .cs__head {
    display: flex; align-items: center; gap: 12px; padding: 15px 16px;
    border-bottom: 1px solid rgba(176, 198, 230, 0.14);
    background: linear-gradient(180deg, rgba(20, 43, 71, 0.6), rgba(20, 43, 71, 0));
    flex-shrink: 0;
  }
  .cs__avatar {
    width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0;
    display: grid; place-items: center; color: var(--navy-ink);
    background: linear-gradient(160deg, var(--gold-light), var(--gold-deep));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }
  .cs__head-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .cs__title { font-family: var(--font-serif); font-weight: 500; font-size: 16px; color: var(--cream); line-height: 1.1; }
  .cs__status { display: inline-flex; align-items: center; gap: 6px; font-size: 11.5px; color: var(--white-70); letter-spacing: 0.02em; }
  .cs__dot { width: 7px; height: 7px; border-radius: 50%; background: #6FCF97; box-shadow: 0 0 7px rgba(111, 207, 151, 0.8); flex-shrink: 0; }
  .cs__close {
    margin-left: auto; flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%;
    display: grid; place-items: center; cursor: pointer; color: var(--white-70);
    background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(176, 198, 230, 0.18);
    transition: color var(--t-fast), background var(--t-fast);
  }
  .cs__close:hover { color: var(--cream); background: rgba(255, 255, 255, 0.1); }

  /* ---------- Thread ---------- */
  .cs__thread {
    flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain;
    padding: 16px 14px 6px; display: flex; flex-direction: column; gap: 10px;
    scrollbar-width: thin; scrollbar-color: rgba(176, 198, 230, 0.3) transparent;
  }
  .cs__thread::-webkit-scrollbar { width: 7px; }
  .cs__thread::-webkit-scrollbar-thumb { background: rgba(176, 198, 230, 0.24); border-radius: 6px; }

  .cs__msg {
    max-width: 86%; padding: 10px 13px; border-radius: 16px; font-size: 13.5px; line-height: 1.5;
    white-space: pre-wrap; word-wrap: break-word; animation: cs-rise 0.3s var(--t-ease, ease) both;
  }
  @keyframes cs-rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  .cs__msg--bot {
    align-self: flex-start; color: var(--cream);
    background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(176, 198, 230, 0.16);
    border-bottom-left-radius: 6px;
  }
  .cs__msg--user {
    align-self: flex-end; color: var(--navy-ink); font-weight: 500;
    background: linear-gradient(160deg, var(--gold-light), var(--gold));
    border-bottom-right-radius: 6px;
  }

  /* Typing indicator */
  .cs__typing { display: inline-flex; gap: 4px; align-items: center; }
  .cs__typing span {
    width: 6px; height: 6px; border-radius: 50%; background: var(--gold-light); opacity: 0.5;
    animation: cs-blink 1.2s infinite ease-in-out;
  }
  .cs__typing span:nth-child(2) { animation-delay: 0.2s; }
  .cs__typing span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes cs-blink { 0%, 80%, 100% { opacity: 0.3; transform: scale(0.85); } 40% { opacity: 1; transform: scale(1); } }
  @media (prefers-reduced-motion: reduce) { .cs__typing span { animation: none; } .cs__msg { animation: none; } }

  /* In-bubble CTA */
  .cs__cta {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 10px;
    padding: 8px 14px; border-radius: 999px; text-decoration: none; font-size: 12.5px; font-weight: 500;
    color: var(--navy-ink); background: linear-gradient(160deg, var(--gold-light), var(--gold-deep));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35); transition: transform var(--t-fast), box-shadow var(--t-fast);
  }
  .cs__cta:hover { transform: translateY(-1px); box-shadow: 0 8px 18px -10px rgba(212, 187, 133, 0.7); }
  .cs__cta-arrow { transition: transform var(--t-fast); }
  .cs__cta:hover .cs__cta-arrow { transform: translateX(3px); }

  /* Quick-reply chips */
  .cs__chips { display: flex; flex-wrap: wrap; gap: 7px; align-self: flex-start; max-width: 96%; margin: 2px 0 4px; }
  .cs__chip {
    cursor: pointer; font-family: inherit; font-size: 12.5px; color: var(--gold-light); text-decoration: none;
    padding: 7px 13px; border-radius: 999px; background: rgba(184, 153, 104, 0.1);
    border: 1px solid var(--hairline-gold-strong); transition: background var(--t-fast), color var(--t-fast), transform var(--t-fast);
    line-height: 1.2;
  }
  .cs__chip:hover { background: rgba(184, 153, 104, 0.22); color: var(--cream); transform: translateY(-1px); }

  /* ---------- Input ---------- */
  .cs__input {
    display: flex; align-items: center; gap: 8px; padding: 12px 12px 6px;
    flex-shrink: 0; border-top: 1px solid rgba(176, 198, 230, 0.12);
  }
  .cs__field {
    flex: 1; min-width: 0; height: 42px; padding: 0 16px; border-radius: 999px;
    font-family: inherit; font-size: 13.5px; color: var(--cream);
    background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(176, 198, 230, 0.18);
    transition: border-color var(--t-fast), background var(--t-fast);
  }
  .cs__field::placeholder { color: var(--white-50); }
  .cs__field:focus { outline: none; border-color: var(--hairline-gold-strong); background: rgba(255, 255, 255, 0.09); }
  .cs__send {
    width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0; cursor: pointer;
    display: grid; place-items: center; color: var(--navy-ink);
    background: linear-gradient(160deg, var(--gold-light), var(--gold-deep));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
    transition: transform var(--t-fast), box-shadow var(--t-fast), opacity var(--t-fast);
  }
  .cs__send:hover { transform: translateY(-1px); box-shadow: 0 8px 18px -10px rgba(212, 187, 133, 0.7); }
  .cs__send:disabled { opacity: 0.5; cursor: default; transform: none; box-shadow: none; }

  .cs__foot {
    margin: 0; padding: 0 12px 12px; display: flex; align-items: center; justify-content: center; gap: 7px;
    font-size: 11px; letter-spacing: 0.02em; color: var(--white-50); flex-shrink: 0;
  }
  .cs__foot :global(.icon) { color: var(--gold); }

  /* ---------- Mobile (not fullscreen-aggressive) ---------- */
  /* Owner call: the launcher lives in the BOTTOM-RIGHT corner on phones
     (the valuation pill owns bottom-left; centred it collided with both). */
  @media (max-width: 480px) {
    .cs { right: 12px; left: auto; bottom: 14px; gap: 12px; align-items: flex-end; }
    .cs__panel { width: calc(100vw - 24px); height: min(74svh, 600px); }
    .cs__fab { position: relative; width: 54px; height: 54px; }
  }
</style>

<script>
  import { getReply, getWelcome, flows, buildLeadPayload, navChips, humanChips, stepKind, type BotReply, type Chip, type FlowId, type Lang } from '../data/supportResponses';
  import { classifyMessage, extractSlots, slotsToAnswers, stepExpectation, detectLang, isFrustrated, type Slots } from '../data/supportRouter';
  import { contacts } from '../data/supportKnowledge';

  const root = document.querySelector<HTMLElement>('[data-cs]');
  if (!root) {
    console.error('[CustomerSupport] Root element [data-cs] not found');
    throw new Error('CustomerSupport initialization failed');
  }

  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-cs-toggle]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-cs-close]');
    const panel = root.querySelector<HTMLElement>('#cs-panel');
    const thread = root.querySelector<HTMLElement>('[data-cs-thread]');
    const form = root.querySelector<HTMLFormElement>('[data-cs-form]');
    const field = root.querySelector<HTMLInputElement>('[data-cs-text]');
    const sendBtn = root.querySelector<HTMLButtonElement>('.cs__send');
    // Lock the composer while a lead is being delivered so the user can't type
    // or cancel mid-send (which would race the pending state / abort a request
    // the server may already have processed).
    const setComposerEnabled = (on: boolean) => {
      if (field) field.disabled = !on;
      if (sendBtn) sendBtn.disabled = !on;
    };

    type Flow = { id: FlowId; step: number; answers: Record<string, string> };
    let started = false;
    let flow: Flow | null = null; // active lead-capture flow
    let suspended: Flow | null = null; // flow paused by an interruption
    let resumeOffered = false; // don't nag about resuming
    let chain: Promise<void> = Promise.resolve();
    // Concurrency: every user input bumps `turn`; queued/in-flight bot output
    // from an older turn is invalidated so a stale reply never lands after a
    // newer message. The newest user message always wins.
    let turn = 0;
    // Language the assistant replies in — sticky, updated when a message is
    // confidently detected as PT or EN (the newest signal wins).
    let lang: Lang = 'pt';
    const t = (pt: string, en: string) => (lang === 'en' ? en : pt);

    /* ---------- panel open/close ---------- */
    const open = () => {
      root.setAttribute('data-open', '');
      toggle?.setAttribute('aria-expanded', 'true');
      toggle?.setAttribute('aria-label', 'Fechar assistente');
      if (panel) panel.hidden = false;
      if (!started) { started = true; greet(); }
      setTimeout(() => field?.focus(), 220);
    };
    const close = () => {
      root.removeAttribute('data-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Abrir assistente');
      if (panel) panel.hidden = true;
    };
    toggle?.addEventListener('click', () => (root.hasAttribute('data-open') ? close() : open()));
    closeBtn?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => e.key === 'Escape' && root.hasAttribute('data-open') && close());

    /* ---------- rendering helpers ---------- */
    const scrollDown = () => { if (thread) thread.scrollTop = thread.scrollHeight; };

    function renderText(el: HTMLElement, text: string) {
      const lines = text.split('\n');
      lines.forEach((line, i) => {
        el.appendChild(document.createTextNode(line));
        if (i < lines.length - 1) el.appendChild(document.createElement('br'));
      });
    }

    function userSay(text: string) {
      if (!thread) return;
      const el = document.createElement('div');
      el.className = 'cs__msg cs__msg--user';
      renderText(el, text);
      thread.appendChild(el);
      scrollDown();
    }

    function clearChips() {
      thread?.querySelectorAll('.cs__chips').forEach((n) => n.remove());
    }

    // Render a finished bot reply (text + optional cta + chips + step chips).
    function renderBot(reply: BotReply & { stepChips?: string[] }) {
      if (!thread) return;
      const el = document.createElement('div');
      el.className = 'cs__msg cs__msg--bot';
      renderText(el, reply.text);
      if (reply.cta) {
        const a = document.createElement('a');
        a.className = 'cs__cta';
        a.href = reply.cta.href;
        if (reply.cta.external) { a.target = '_blank'; a.rel = 'noopener noreferrer'; }
        a.appendChild(document.createTextNode(reply.cta.label));
        const arrow = document.createElement('span');
        arrow.className = 'cs__cta-arrow'; arrow.textContent = '→';
        a.appendChild(arrow);
        el.appendChild(a);
      }
      thread.appendChild(el);

      const chips: Chip[] = [...(reply.chips ?? [])];
      const stepChips = (reply.stepChips ?? []).map((label) => ({ label, answer: true } as Chip & { answer: boolean }));
      // At most 4 quick options (free text is always available via the input).
      const all = [...stepChips, ...chips].slice(0, 4) as (Chip & { answer?: boolean })[];
      if (all.length) {
        const row = document.createElement('div');
        row.className = 'cs__chips';
        for (const c of all) {
          if (c.href) {
            const a = document.createElement('a');
            a.className = 'cs__chip'; a.href = c.href; a.textContent = c.label;
            if (c.external) { a.target = '_blank'; a.rel = 'noopener noreferrer'; }
            row.appendChild(a);
          } else {
            const b = document.createElement('button');
            b.type = 'button'; b.className = 'cs__chip'; b.textContent = c.label;
            if (c.answer) b.dataset.answer = '1';
            if (c.flow) b.dataset.flow = c.flow;
            if (c.send) b.dataset.send = c.send;
            if (c.consent) b.dataset.consent = c.consent;
            if (c.action) b.dataset.action = c.action;
            row.appendChild(b);
          }
        }
        thread.appendChild(row);
      }
      scrollDown();
    }

    // Queue a bot message behind a short typing indicator (sequential). Tagged
    // with the turn it was enqueued in: if a newer user message arrives first,
    // the message is dropped instead of rendering out of order.
    function botSay(reply: BotReply & { stepChips?: string[] }) {
      const myTurn = turn;
      chain = chain.then(
        () =>
          new Promise<void>((resolve) => {
            if (!thread || myTurn !== turn) return resolve(); // stale → skip
            const typing = document.createElement('div');
            typing.className = 'cs__msg cs__msg--bot cs__typing';
            typing.innerHTML = '<span></span><span></span><span></span>';
            thread.appendChild(typing);
            scrollDown();
            window.setTimeout(() => {
              typing.remove();
              if (myTurn === turn) renderBot(reply); // re-check at render time
              resolve();
            }, 440);
          }),
      );
    }

    /* ---------- shared helpers (bilingual) ---------- */
    function objectiveLabel(id: FlowId): string {
      const m: Record<FlowId, [string, string]> = {
        comprar: ['a procura de imóvel', 'your property search'],
        vender: ['a venda', 'the sale'],
        alugar: ['o arrendamento', 'the rental'],
        avaliacao: ['o pedido de avaliação', 'your valuation request'],
        visita: ['a marcação da visita', 'the viewing'],
        carreira: ['a candidatura', 'your application'],
      };
      return t(m[id][0], m[id][1]);
    }
    function objectiveShort(id: FlowId): string {
      const m: Record<FlowId, [string, string]> = {
        comprar: ['Comprar', 'Buy'],
        vender: ['Vender', 'Sell'],
        alugar: ['Arrendar', 'Rent'],
        avaliacao: ['Avaliação', 'Valuation'],
        visita: ['Visita', 'Viewing'],
        carreira: ['Candidatura', 'Application'],
      };
      return t(m[id][0], m[id][1]);
    }

    // Trim a knowledge reply to a short chat answer: keep the opening prose,
    // drop bullet/emoji list lines, cap at ~45 words on a sentence boundary.
    function concise(text: string): string {
      const firstBlock = text.split('\n\n')[0];
      const prose = firstBlock
        .split('\n')
        .filter((l) => !/^\s*[•\-📞📍📝⏰💬📧🏆]/.test(l))
        .join(' ')
        .replace(/\s+/g, ' ')
        .trim();
      const base = (prose || firstBlock.replace(/\s+/g, ' ').trim()).replace(/:\s*$/, '.');
      const words = base.split(' ');
      if (words.length <= 45) return base;
      let out = words.slice(0, 45).join(' ');
      const cut = Math.max(out.lastIndexOf('. '), out.lastIndexOf('! '), out.lastIndexOf('? '));
      out = cut > 24 ? out.slice(0, cut + 1) : out.replace(/[,;:]?\s*\S*$/, '') + '…';
      return out;
    }

    function replyConcise(userText: string): BotReply {
      const r = getReply(userText, lang);
      return { text: concise(r.text), chips: r.chips, cta: r.cta };
    }

    function deliverConcise(reply: BotReply) {
      botSay({ text: concise(reply.text), chips: reply.chips, cta: reply.cta });
      if (reply.flow) startFlow(reply.flow, {});
    }

    /* ---------- flow lifecycle ---------- */
    function greet() {
      botSay({ ...getWelcome(lang), chips: navChips(lang) });
    }

    function startFlow(id: FlowId, prefill: Slots) {
      flow = { id, step: 0, answers: {} };
      suspended = null;
      resumeOffered = false;
      Object.assign(flow.answers, slotsToAnswers(id, prefill)); // skip what we know
      botSay({ text: flows[id].intro[lang] });
      advanceOrAsk();
    }

    // The zone the user has already given (to personalize later questions).
    function zoneAnswered(): string | null {
      if (!flow) return null;
      for (const step of flows[flow.id].steps) {
        if (stepExpectation(step.key) === 'zone' && flow.answers[step.key]) return flow.answers[step.key];
      }
      return null;
    }

    function askStep() {
      if (!flow) return;
      const step = flows[flow.id].steps[flow.step];
      let q = step.question[lang];
      // Personalize with what we already know: reference the given zone once,
      // on the typology step (reads naturally: "…em Foz?" / "…in Foz?").
      const zone = zoneAnswered();
      if (zone && stepExpectation(step.key) === 'typology') q = q.replace(/\?\s*$/, t(` em ${zone}?`, ` in ${zone}?`));
      botSay({ text: q, stepChips: step.chips?.[lang] });
    }

    // Ask the next unanswered step, skipping any pre-filled ones; when every
    // step is answered, move to the consent gate.
    function advanceOrAsk() {
      if (!flow) return;
      const f = flows[flow.id];
      while (flow.step < f.steps.length && flow.answers[f.steps[flow.step].key]) flow.step += 1;
      if (flow.step < f.steps.length) { askStep(); return; }
      beginConsent();
    }

    /* ---------- lead delivery (consent + Resend, idempotent) ---------- */
    let pending: { flowId: FlowId; answers: Record<string, string>; submissionId: string } | null = null;
    let sending = false;
    let sendAbort: AbortController | null = null;

    // Only the confirmed, non-personal details (objective · zone · typology…),
    // shown before asking to send.
    function confirmedSummary(flowId: FlowId, answers: Record<string, string>): string {
      const bits: string[] = [objectiveShort(flowId)];
      for (const step of flows[flowId].steps) {
        const v = answers[step.key];
        if (v && stepKind(step.key) === 'free') bits.push(v);
      }
      const name = answers['Nome'];
      return bits.join(' · ') + (name ? ` — ${name}` : '');
    }

    function beginConsent() {
      if (!flow) return;
      pending = { flowId: flow.id, answers: { ...flow.answers }, submissionId: crypto.randomUUID() };
      flow = null;
      suspended = null;
      askConsent();
    }

    function askConsent() {
      if (!pending) return;
      const summary = confirmedSummary(pending.flowId, pending.answers);
      botSay({
        text: t(
          `Confirmo: ${summary}. Autoriza que envie à equipa? (nos termos da Política de Privacidade)`,
          `To confirm: ${summary}. May I send this to the team? (per our Privacy Policy)`,
        ),
        cta: { label: t('Política de Privacidade', 'Privacy Policy'), href: '/privacidade' },
        chips: [
          { label: t('Autorizar e enviar', 'Authorise and send'), consent: 'send' },
          { label: t('Cancelar', 'Cancel'), consent: 'cancel' },
        ],
      });
    }

    async function handleConsent(action: string) {
      if (action === 'cancel') {
        pending = null;
        sendAbort?.abort();
        botSay({ text: t('Sem problema, não enviei nada. Em que mais posso ajudar?', 'No problem, I haven’t sent anything. How else can I help?'), chips: navChips(lang) });
        return;
      }
      await sendLead(); // 'send' or 'retry'
    }

    // Success is shown ONLY after the server confirms real delivery
    // (delivered:true), and only if it is still the newest turn; on failure the
    // pending lead is kept so the user can retry with a single tap.
    async function sendLead() {
      if (!pending || sending) return; // block double-send while in flight
      sending = true;
      setComposerEnabled(false); // lock the composer for the whole round-trip
      sendAbort = new AbortController();
      try {
        const payload = buildLeadPayload(pending.flowId, pending.answers);
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...payload, submission_id: pending.submissionId }),
          signal: sendAbort.signal,
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.delivered === true) {
          pending = null;
          botSay({ text: t('Enviado. A equipa entra em contacto em breve, normalmente em 24h.', 'Sent. The team will be in touch shortly, usually within 24h.'), chips: humanChips(lang) });
          return;
        }
        throw new Error('not delivered');
      } catch (e) {
        if ((e as { name?: string })?.name === 'AbortError') return; // superseded
        botSay({
          text: t('Não consegui enviar agora. Pode tentar novamente ou contactar-nos diretamente.', 'I couldn’t send it just now. You can try again or contact us directly.'),
          chips: [{ label: t('Tentar novamente', 'Try again'), consent: 'retry' }, { label: t('Ligar', 'Call'), href: contacts.phoneHref }],
        });
      } finally {
        sending = false;
        setComposerEnabled(true);
      }
    }

    /* ---------- interruption / resume ---------- */
    function offerResume() {
      if (!suspended || resumeOffered) return; // ask once, never nag
      resumeOffered = true;
      botSay({
        text: t(`Quer retomar ${objectiveLabel(suspended.id)}?`, `Would you like to resume ${objectiveLabel(suspended.id)}?`),
        chips: [{ label: t('Retomar', 'Resume'), action: 'resume' }, { label: t('Não, obrigado', 'No, thanks'), action: 'dismiss' }],
      });
    }

    function resumeFlow() {
      if (!suspended) return;
      flow = suspended;
      suspended = null;
      resumeOffered = false;
      botSay({ text: t('Com certeza, retomamos.', 'Of course, let’s resume.') });
      askStep();
    }

    /* ---------- decision handlers (one per classification) ---------- */
    function doAnswer(text: string) {
      if (!flow) return;
      const step = flows[flow.id].steps[flow.step];
      const exp = stepExpectation(step.key);
      const slots = extractSlots(text);
      const raw = text.trim();
      // Keep the user's own words when they give a range or alternatives
      // ("T3 ou T4", "500-800 mil"); otherwise store the tidy extracted value.
      const multi = /\b(ou|or|entre|between)\b|,|\/|\d\s*[–—-]\s*\d/i.test(raw);
      let value = raw;
      if (!multi) {
        if (exp === 'zone' && slots.zone) value = slots.zone;
        else if (exp === 'typology' && slots.typology) value = slots.typology;
        else if (exp === 'budget' && slots.budget) value = slots.budget;
      }
      flow.answers[step.key] = value;
      flow.step += 1;
      advanceOrAsk();
    }

    function doNav(command: 'cancel' | 'restart' | 'back' | 'human') {
      if (command === 'cancel') {
        flow = null; suspended = null; pending = null; sendAbort?.abort();
        botSay({ text: t('Sem problema, cancelei. Em que mais posso ajudar?', 'No problem, cancelled. How else can I help?'), chips: navChips(lang) });
        return;
      }
      if (command === 'restart') {
        flow = null; suspended = null; pending = null; resumeOffered = false;
        botSay({ text: t('Vamos recomeçar. Comprar, vender, arrendar ou avaliar um imóvel?', 'Let’s start over. Buying, selling, renting or valuing a property?'), chips: navChips(lang) });
        return;
      }
      if (command === 'back') {
        if (flow && flow.step > 0) { flow.step -= 1; askStep(); return; }
        if (flow) { botSay({ text: t('Estamos na primeira pergunta.', 'We’re on the first question.') }); askStep(); return; }
        if (suspended) { resumeFlow(); return; }
        botSay({ text: t('Não há nada em curso para retomar. Em que posso ajudar?', 'There’s nothing in progress to resume. How can I help?'), chips: navChips(lang) });
        return;
      }
      // human hand-off — suspend the flow so it can still be resumed.
      if (flow) { suspended = flow; flow = null; }
      botSay({ text: t('Com certeza. Fale diretamente com a nossa equipa:', 'Of course. Speak directly with our team:'), chips: humanChips(lang) });
      offerResume();
    }

    function doDecline() {
      if (flow) { suspended = flow; flow = null; }
      const chips: Chip[] = [...humanChips(lang)];
      if (suspended) chips.push({ label: t('Continuar', 'Continue'), action: 'resume' });
      chips.push({ label: t('Cancelar', 'Cancel'), action: 'cancel' });
      botSay({ text: t('Sem problema, não é obrigatório. Prefere falar diretamente com a equipa?', 'No problem, it’s not required. Would you rather speak with the team directly?'), chips });
    }

    function doClarify() {
      if (flow) {
        const step = flows[flow.id].steps[flow.step];
        botSay({ text: t('Peço desculpa. ', 'Apologies. ') + step.question[lang], stepChips: step.chips?.[lang] });
        return;
      }
      botSay({ text: t('Desculpe — pode reformular? Ajudo com compra, venda, arrendamento ou avaliação.', 'Sorry — could you rephrase? I can help with buying, selling, renting or valuation.'), chips: navChips(lang) });
    }

    function doSwitch(objective: FlowId, slots: Slots) {
      // Carry over compatible details (zone / typology / budget) so the user
      // doesn't repeat them after changing objective.
      const carried: Slots = { zone: slots.zone, typology: slots.typology, budget: slots.budget };
      if (flow) {
        for (const step of flows[flow.id].steps) {
          const v = flow.answers[step.key];
          if (!v) continue;
          const exp = stepExpectation(step.key);
          if (exp === 'zone' && !carried.zone) carried.zone = v;
          if (exp === 'typology' && !carried.typology) carried.typology = v;
          if (exp === 'budget' && !carried.budget) carried.budget = v;
        }
      }
      flow = null; suspended = null;
      startFlow(objective, carried);
    }

    function doCorrection(slots: Slots) {
      if (!flow) { doQuestion('', slots); return; }
      const applied: string[] = [];
      for (const step of flows[flow.id].steps) {
        const exp = stepExpectation(step.key);
        if (exp === 'zone' && slots.zone) { flow.answers[step.key] = slots.zone; applied.push(slots.zone); }
        if (exp === 'typology' && slots.typology) { flow.answers[step.key] = slots.typology; applied.push(slots.typology); }
        if (exp === 'budget' && slots.budget) { flow.answers[step.key] = slots.budget; applied.push(slots.budget); }
      }
      botSay({ text: applied.length ? t(`Corrigido: ${applied.join(', ')}.`, `Updated: ${applied.join(', ')}.`) : t('Anotado.', 'Noted.') });
      advanceOrAsk();
    }

    function doQuestion(text: string, slots: Slots) {
      if (flow) {
        // Interruption: suspend the flow silently, answer first, then offer to
        // resume — never auto-advance to the next question.
        if (!suspended) suspended = flow;
        flow = null;
        if (text) botSay(replyConcise(text));
        offerResume();
        return;
      }
      if (slots.objective) { startFlow(slots.objective, slots); return; }
      deliverConcise(getReply(text, lang));
    }

    function doAmbiguous() {
      if (flow) {
        const step = flows[flow.id].steps[flow.step];
        botSay({ text: t('Desculpe, não percebi bem. ', 'Sorry, I didn’t quite get that. ') + step.question[lang], stepChips: step.chips?.[lang] });
        return;
      }
      botSay({
        text: t('Posso passá-lo à equipa, ou diga-me se procura comprar, vender ou arrendar.', 'I can put you through to the team, or tell me if you’re looking to buy, sell or rent.'),
        chips: [...navChips(lang).slice(0, 2), ...humanChips(lang)],
      });
    }

    function onAction(action: string) {
      if (action === 'resume') { resumeFlow(); return; }
      if (action === 'dismiss') {
        suspended = null; resumeOffered = false;
        botSay({ text: t('Combinado. Em que mais posso ajudar?', 'Sure. How else can I help?'), chips: navChips(lang) });
        return;
      }
      if (action === 'cancel') { doNav('cancel'); return; }
      if (action === 'restart') { doNav('restart'); return; }
      if (action === 'human') { doNav('human'); return; }
    }

    // A lead is awaiting consent and the user typed instead of tapping: honour
    // cancel / human, answer a question, but never lose the pending lead.
    function handleConsentInterruption(text: string) {
      const c = classifyMessage(text, { inFlow: false });
      if (c.kind === 'nav' && c.command === 'cancel') {
        pending = null; sendAbort?.abort();
        botSay({ text: t('Sem problema, não enviei nada. Em que mais posso ajudar?', 'No problem, I haven’t sent anything. How else can I help?'), chips: navChips(lang) });
        return;
      }
      if (c.kind === 'nav' && c.command === 'human') {
        botSay({
          text: t('Com certeza — fale já com a equipa, ou confirme o envio do seu pedido:', 'Of course — speak with the team now, or confirm sending your request:'),
          chips: [...humanChips(lang), { label: t('Autorizar e enviar', 'Authorise and send'), consent: 'send' }, { label: t('Cancelar', 'Cancel'), consent: 'cancel' }],
        });
        return;
      }
      // Answer the question but WITHOUT its chips — while a lead awaits consent
      // the only actionable chips must be the consent ones (re-rendered below).
      if (c.kind === 'question') botSay({ text: replyConcise(text).text });
      askConsent(); // re-present the gate so the pending lead survives
    }

    /* ---------- the router: re-classify EVERY message ---------- */
    function route(text: string) {
      const msg = text.trim();
      if (!msg) return;
      turn += 1; // newest input wins; invalidates queued/in-flight bot output
      const detected = detectLang(msg); // adapt to the visitor's language (sticky)
      if (detected) lang = detected;
      userSay(msg);
      clearChips();

      if (pending) { handleConsentInterruption(msg); return; }

      const step = flow ? flows[flow.id].steps[flow.step] : null;
      const ctx = flow
        ? { inFlow: true, flowId: flow.id, stepKey: step!.key, answeredKeys: Object.keys(flow.answers) }
        : { inFlow: false };
      const c = classifyMessage(msg, ctx);

      // Frustrated visitor: acknowledge once and redirect — but not when the
      // message already routes to an empathetic handler (problem / human),
      // which would apologise a second time ("não se justificar em excesso").
      const empathetic =
        (c.kind === 'nav' && c.command === 'human') ||
        (c.kind === 'question' && (c.intent === 'problema' || c.intent === 'humano'));
      if (isFrustrated(msg) && !empathetic) {
        botSay({ text: t('Lamento — vou ajudá-lo já.', 'Sorry about that — let me help right away.') });
      }

      switch (c.kind) {
        case 'nav': doNav(c.command); return;
        case 'decline': doDecline(); return;
        case 'clarify': doClarify(); return;
        case 'switch': doSwitch(c.objective, c.slots); return;
        case 'correction': doCorrection(c.slots); return;
        case 'answer': doAnswer(msg); return;
        case 'question': doQuestion(msg, c.slots); return;
        case 'ambiguous': doAmbiguous(); return;
      }
    }

    /* ---------- input + chip events ---------- */
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!field || sending) return; // ignore input while a lead is being sent
      const v = field.value;
      field.value = '';
      route(v);
    });

    thread?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest('button.cs__chip') as HTMLButtonElement | null;
      if (!btn || sending) return; // ignore taps while a lead is being sent
      const label = btn.textContent ?? '';
      clearChips();
      // Every chip tap is a user turn — bump `turn` so older bot output drops.
      if (btn.dataset.action) { turn += 1; onAction(btn.dataset.action); return; }
      if (btn.dataset.consent) { turn += 1; userSay(label); handleConsent(btn.dataset.consent); return; }
      // While a lead awaits consent, a stray flow/answer/send chip must not
      // start a new flow off the still-live `pending` — route it through the
      // consent interruption instead (mirrors the typed-message guard).
      if (pending) { turn += 1; userSay(label); handleConsentInterruption(label); return; }
      if (btn.dataset.answer) { turn += 1; userSay(label); doAnswer(label); return; }
      if (btn.dataset.flow) { turn += 1; userSay(label); startFlow(btn.dataset.flow as FlowId, {}); return; }
      if (btn.dataset.send) { turn += 1; userSay(label); deliverConcise(getReply(btn.dataset.send, lang)); return; }
    });
  }
</script>
