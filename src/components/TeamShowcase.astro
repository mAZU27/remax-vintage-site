---
// "A Nossa Equipa" — premium team carousel.
// Navy zone: editorial header + an interactive horizontal carousel of portrait
// cards (draggable, swipeable, keyboard-navigable, infinite loop), then a soft
// curve into the cream zone with stats + CTA.
// Each card uses <picture> (webp 400w/600w + jpg fallback). When a portrait is
// absent or fails to load, a dignified gold-monogram fallback takes over.
// Clicks open the official RE/MAX team page. Reveal + motion-safety respected.
import Icon from './Icon.astro';
import { consultants, teamStats, teamShowcase } from '../data/team';

const REMAX_TEAM_URL = 'https://www.remax.pt/pt/agencia/remax-collection-vintage/12382#:~:text=Equipa';

const initials = (name: string) =>
  name
    .trim()
    .split(/\s+/)
    .map((w) => w[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();

// Infinite carousel: consult list looped for seamless infinite scrolling
// (visible copy + phantom copy on each end). Drag/swipe/arrow/keyboard controls.
const LOOP_COPIES = 3;
const carouselData = Array.from({ length: LOOP_COPIES }, (_, copy) =>
  consultants.map((c) => ({ ...c, loopCopy: copy }))
).flat();
---

<section class="ts on-navy" aria-labelledby="ts-title">
  <div class="container">
    <header class="ts__head">
      <div class="ts__head-l">
        <span class="ts__eyebrow" data-reveal>{teamShowcase.eyebrow}</span>
        <h2 id="ts-title" class="ts__title" data-reveal style="--reveal-delay:90ms">{teamShowcase.titleLine1}</h2>
        <p class="ts__title-2 serif-it" data-reveal style="--reveal-delay:160ms">{teamShowcase.titleLine2}</p>
      </div>
      <div class="ts__head-r">
        <p class="ts__intro" data-reveal style="--reveal-delay:220ms">{teamShowcase.intro}</p>
        <svg class="ts__bldg" viewBox="0 0 128 96" fill="none" aria-hidden="true">
          <path
            d="M6 42 L64 10 L122 42 M12 48 H116 M22 52 V82 M44 52 V82 M66 52 V82 M88 52 V82 M110 52 V82 M14 82 H114 M8 90 H120"
          />
        </svg>
      </div>
    </header>

    <!-- Interactive carousel: drag, swipe, arrow keys, keyboard nav -->
    <div class="ts__carousel" data-carousel role="region" aria-label="Equipa da Collection Vintage">
      <div class="ts__marquee">
        <ul class="ts__track" role="list" data-carousel-track>
          {carouselData.map((c, idx) => (
            <li class="ts__cell" data-carousel-item={idx} aria-hidden={c.loopCopy !== 0 ? 'true' : undefined}>
              <a href={REMAX_TEAM_URL} target="_blank" rel="noopener noreferrer" class="ts__card-link" aria-label={`${c.name}, ${c.role} - Abrir na RE/MAX`}>
                <article class="ts__card">
                  <div class:list={['ts__photo', { 'is-missing': !c.image }]}>
                    {c.image && (
                      <picture>
                        {c.hasWebp !== false && (
                          <source
                            type="image/webp"
                            srcset={`${c.image}-400.webp 400w, ${c.image}-600.webp 600w`}
                            sizes="(max-width: 700px) 240px, 268px"
                          />
                        )}
                        <img
                          src={`${c.image}.jpg`}
                          alt={`${c.name}, ${c.role} — RE/MAX Collection Vintage, Porto`}
                          loading="lazy"
                          decoding="async"
                          width="600"
                          height="800"
                          draggable={false}
                        />
                      </picture>
                    )}
                    <span class="ts__mono" aria-hidden="true">{initials(c.name)}</span>
                    <div class="ts__scrim" aria-hidden="true"></div>
                    <div class="ts__info">
                      <span class="ts__role">{c.role}</span>
                      {c.zone && <span class="ts__zone">{c.zone}</span>}
                    </div>
                  </div>
                </article>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Navigation arrows -->
      <button class="ts__nav ts__nav--prev" data-carousel-prev aria-label="Card anterior" type="button">
        <Icon name="chevron-left" size={20} stroke={1.8} />
      </button>
      <button class="ts__nav ts__nav--next" data-carousel-next aria-label="Próximo card" type="button">
        <Icon name="chevron-right" size={20} stroke={1.8} />
      </button>
    </div>

    <!-- CTA to full team page -->
    <div class="ts__cta-group" data-reveal style="--reveal-delay:300ms">
      <a class="ts__cta-link" href={REMAX_TEAM_URL} target="_blank" rel="noopener noreferrer">
        <span>{teamShowcase.cta.label}</span>
        <Icon name="arrow" size={15} stroke={1.8} />
      </a>
    </div>
  </div>

  <div class="ts__divider" aria-hidden="true">
    <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
      <path class="ts__curve-fill" d="M0 78 C 360 78 520 34 720 34 C 920 34 1080 78 1440 78 L 1440 120 L 0 120 Z" />
      <path class="ts__curve-line" d="M0 78 C 360 78 520 34 720 34 C 920 34 1080 78 1440 78" />
    </svg>
  </div>
</section>

<section class="ts-stats">
  <div class="container">
    <ul class="ts-stats__grid">
      {teamStats.map((s, i) => (
        <li class="ts-stat" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <span class="ts-stat__ic"><Icon name={s.icon} size={26} stroke={1.4} /></span>
          <span class="ts-stat__val">{s.value}</span>
          <span class="ts-stat__lab">{s.label}</span>
        </li>
      ))}
    </ul>
    <div class="ts-stats__cta" data-reveal style="--reveal-delay:120ms">
      <a class="ts__cta" href={teamShowcase.cta.href}>
        <span>{teamShowcase.cta.label}</span>
        <Icon name="arrow" size={15} stroke={1.8} />
      </a>
    </div>
  </div>
</section>

<style>
  /* ---------- Navy zone ---------- */
  .ts {
    position: relative;
    overflow: hidden;
    background: var(--navy-ink);
    color: var(--cream);
    padding-top: clamp(64px, 8vw, 110px);
  }

  .ts__head {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
    margin-bottom: clamp(28px, 3.4vw, 48px);
  }

  .ts__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-sans);
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold-light);
  }
  .ts__eyebrow::before,
  .ts__eyebrow::after {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--gold);
  }

  .ts__title {
    margin: 18px 0 0;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(30px, 4.2vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--cream);
  }
  .ts__title-2 {
    margin: 6px 0 0;
    font-size: clamp(22px, 2.8vw, 34px);
    line-height: 1.1;
    color: var(--gold-light);
  }

  .ts__head-r {
    display: flex;
    flex-direction: column;
    padding-top: 6px;
  }
  .ts__intro {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(15px, 1.1vw, 16.5px);
    line-height: 1.7;
    color: var(--white-70);
  }
  .ts__bldg {
    display: block;
    width: clamp(120px, 13vw, 168px);
    height: auto;
    margin: 22px 0 0 auto;
    color: var(--gold-light);
    opacity: 0.22;
  }
  .ts__bldg path {
    stroke: currentColor;
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- Interactive carousel ---------- */
  .ts__carousel {
    --ts-card-w: clamp(232px, 21vw, 268px);
    --ts-gap: clamp(14px, 1.5vw, 22px);
    position: relative;
    overflow: visible;
  }

  .ts__marquee {
    position: relative;
    overflow: hidden;
    /* Vertical room so the hover float-shadow is not clipped. */
    padding-block: clamp(24px, 3vw, 40px);
    /* Soft edges so cards dissolve in/out instead of hard-cutting at the seam. */
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 5%, #000 95%, transparent 100%);
            mask-image: linear-gradient(to right, transparent 0, #000 5%, #000 95%, transparent 100%);
  }

  .ts__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    width: max-content;
    will-change: transform;
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    /* No auto-animation; controlled by JavaScript */
  }
  .ts__track.is-dragging {
    transition: none;
  }

  /* Fixed card width + uniform right margin keeps the track perfectly periodic. */
  .ts__cell {
    flex: 0 0 var(--ts-card-w);
    width: var(--ts-card-w);
    min-width: 0;
    margin-right: var(--ts-gap);
    position: relative;
  }

  .ts__card-link {
    display: block;
    text-decoration: none;
    cursor: grab;
    position: relative;
    /* Prevent text selection during drag */
    user-select: none;
    -webkit-user-select: none;
  }
  .ts__card-link.is-dragging {
    cursor: grabbing;
  }
  .ts__track.is-dragging .ts__card-link {
    pointer-events: none;
  }

  .ts__card {
    position: relative;
    border-radius: 2px;
    overflow: hidden;
    border: 1px solid var(--hairline-gold);
    background: var(--navy);
    transition: transform var(--t-med) var(--t-ease-emph),
      box-shadow var(--t-med) var(--t-ease-emph), border-color var(--t-med);
  }
  .ts__card-link:hover .ts__card {
    transform: translateY(-6px);
    border-color: var(--hairline-gold-strong);
    box-shadow: var(--shadow-float);
  }

  .ts__photo {
    position: relative;
    aspect-ratio: 3 / 4;
    background: var(--navy);
    overflow: hidden;
  }
  .ts__photo picture { display: block; width: 100%; height: 100%; }
  .ts__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.7s var(--t-ease-emph);
  }
  .ts__card:hover .ts__photo img { transform: scale(1.045); }

  /* Gold-monogram fallback — shown when a portrait is absent or fails to load */
  .ts__mono {
    position: absolute;
    inset: 0;
    display: none;
    place-items: center;
    font-family: var(--font-serif);
    font-size: clamp(44px, 5vw, 64px);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--gold);
    opacity: 0.5;
    transition: opacity var(--t-med) var(--t-ease-emph), transform var(--t-med) var(--t-ease-emph);
  }
  .ts__card:hover .ts__mono { opacity: 0.7; transform: scale(1.04); }
  .ts__photo.is-missing picture { display: none; }
  .ts__photo.is-missing .ts__mono { display: grid; }

  /* Bottom scrim keeps the caption legible over any portrait (transparent -> navy) */
  .ts__scrim {
    position: absolute;
    inset: auto 0 0;
    height: 62%;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--navy-ink) 90%, transparent) 0%,
      color-mix(in srgb, var(--navy-ink) 60%, transparent) 34%,
      transparent 100%
    );
    pointer-events: none;
  }

  .ts__info {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: clamp(13px, 1.2vw, 18px);
  }
  .ts__role {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .ts__zone {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.3;
    color: var(--white-70);
  }

  /* ---------- Navigation arrows ---------- */
  .ts__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 2px;
    display: grid;
    place-items: center;
    background: rgba(184, 153, 104, 0.08);
    border: 1px solid var(--hairline-gold);
    color: var(--gold-light);
    cursor: pointer;
    z-index: 10;
    transition: background var(--t-fast), border-color var(--t-fast), color var(--t-fast), transform var(--t-fast);
    -webkit-appearance: none;
    appearance: none;
  }
  .ts__nav:hover {
    background: rgba(184, 153, 104, 0.15);
    border-color: var(--hairline-gold-strong);
    color: var(--cream);
    transform: translateY(-50%) scale(1.08);
  }
  .ts__nav:active {
    transform: translateY(-50%) scale(0.96);
  }
  .ts__nav:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .ts__nav--prev {
    left: clamp(12px, 1.2vw, 24px);
  }
  .ts__nav--next {
    right: clamp(12px, 1.2vw, 24px);
  }

  /* CTA to full team page */
  .ts__cta-group {
    text-align: center;
    margin-top: clamp(28px, 3.5vw, 48px);
  }
  .ts__cta-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 30px;
    border-radius: var(--radius);
    background: var(--gold);
    color: var(--navy-ink);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 12.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background var(--t-med), box-shadow var(--t-med), transform var(--t-med);
    cursor: pointer;
  }
  .ts__cta-link:hover {
    background: var(--gold-deep);
    box-shadow: var(--shadow-float);
    transform: translateY(-2px);
  }
  .ts__cta-link:focus-visible {
    outline: 2px solid var(--gold-deep);
    outline-offset: 3px;
  }
  .ts__cta-link :global(.icon) {
    transition: transform var(--t-med);
  }
  .ts__cta-link:hover :global(.icon) {
    transform: translateX(4px);
  }

  /* ---------- Curve divider (navy -> cream) ---------- */
  .ts__divider {
    position: relative;
    margin-top: clamp(38px, 5vw, 68px);
    line-height: 0;
  }
  .ts__divider svg { display: block; width: 100%; height: clamp(54px, 7vw, 102px); }
  .ts__curve-fill { fill: var(--cream-soft); }
  .ts__curve-line {
    fill: none;
    stroke: var(--hairline-gold-strong);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }

  /* ---------- Cream zone — stats + CTA ---------- */
  .ts-stats {
    background: var(--cream-soft);
    padding: clamp(44px, 6vw, 78px) 0 clamp(56px, 7vw, 96px);
  }
  .ts-stats__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .ts-stat {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    padding: clamp(8px, 1.4vw, 16px) clamp(12px, 2vw, 26px);
  }
  .ts-stat + .ts-stat::before {
    content: "";
    position: absolute;
    left: 0;
    top: 16%;
    bottom: 16%;
    width: 1px;
    background: var(--ink-10);
  }
  .ts-stat__ic { color: var(--gold-deep); }
  .ts-stat__val {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--navy);
  }
  .ts-stat__lab {
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-60);
  }


  /* ---------- Responsive ---------- */
  @media (max-width: 760px) {
    .ts__head { grid-template-columns: 1fr; gap: 18px; }
    .ts__bldg { display: none; }
    .ts-stats__grid { grid-template-columns: repeat(2, 1fr); row-gap: clamp(22px, 5vw, 32px); }
    .ts-stat::before { display: none; }
    .ts-stat:nth-child(even)::before { display: block; }
  }

  /* Mobile: CTA goes full-width, arrows remain but smaller */
  @media (max-width: 640px) {
    .ts__cta-link { width: 100%; justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Disable transitions during drag and snap */
    .ts__track { transition: none !important; }
    .ts__card,
    .ts__mono,
    .ts__photo img,
    .ts__cta-link,
    .ts__cta-link :global(.icon) { transition: none !important; }
    .ts__card-link:hover .ts__card { transform: none; }
    .ts__card:hover .ts__photo img { transform: none; }
    .ts__card:hover .ts__mono { transform: none; }
  }
</style>

<script>
  // Interactive carousel: drag, swipe, arrows, keyboard
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  const track = carousel?.querySelector<HTMLElement>('[data-carousel-track]');
  const prevBtn = carousel?.querySelector<HTMLButtonElement>('[data-carousel-prev]');
  const nextBtn = carousel?.querySelector<HTMLButtonElement>('[data-carousel-next]');

  if (!carousel || !track) throw new Error('[TeamShowcase] Carousel not found');

  let CARD_WIDTH = 0;
  let CARDS_PER_LOOP = 59; // Default, updated on resize
  let currentIndex = CARDS_PER_LOOP;
  let isDragging = false;
  let startX = 0;
  let dragX = 0;
  let lastX = 0;
  let lastTime = 0;

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function calculateLayout() {
    const item = track?.children[0] as HTMLElement;
    if (item) {
      CARD_WIDTH = item.offsetWidth + 22; // Card width + gap
    }
  }

  function getTranslate(): number {
    const style = window.getComputedStyle(track!);
    const transform = style.transform;
    if (transform === 'none') return 0;
    const match = transform.match(/matrix3d?\((.+)\)/);
    if (!match) return 0;
    const values = match[1].split(', ');
    return parseInt(values[values.length === 16 ? 12 : 4] || '0', 10);
  }

  function setTranslate(x: number) {
    track!.style.transform = `translateX(${x}px)`;
  }

  function snapToCard(index: number) {
    let nextIndex = index;
    // Clamp and loop
    if (nextIndex < CARDS_PER_LOOP) nextIndex += CARDS_PER_LOOP;
    if (nextIndex >= CARDS_PER_LOOP * 2) nextIndex -= CARDS_PER_LOOP;

    const targetX = -(nextIndex * CARD_WIDTH);
    track!.classList.remove('is-dragging');
    track!.style.transition = prefersReducedMotion ? 'none' : '0.6s cubic-bezier(0.34, 1.56, 0.64, 1)';
    setTranslate(targetX);
    currentIndex = nextIndex;
  }

  function handleDragStart(e: MouseEvent | TouchEvent) {
    if ((e.target as HTMLElement).closest('a')) return;
    isDragging = true;
    startX = 'clientX' in e ? e.clientX : e.touches?.[0].clientX || 0;
    dragX = 0;
    lastX = startX;
    lastTime = Date.now();
    track!.classList.add('is-dragging');
    track!.style.transition = 'none';
  }

  function handleDragMove(e: MouseEvent | TouchEvent) {
    if (!isDragging) return;
    const currentX = 'clientX' in e ? e.clientX : e.touches?.[0].clientX || 0;
    dragX = currentX - startX;
    setTranslate(getTranslate() + (currentX - lastX));
    lastX = currentX;
  }

  function handleDragEnd() {
    if (!isDragging) return;
    isDragging = false;
    const threshold = CARD_WIDTH * 0.15;
    const newIndex = dragX < -threshold ? currentIndex + 1 : dragX > threshold ? currentIndex - 1 : currentIndex;
    snapToCard(newIndex);
  }

  function handleArrowClick(dir: number) {
    snapToCard(currentIndex + dir);
  }

  function handleKeyDown(e: KeyboardEvent) {
    if (e.key === 'ArrowLeft') { e.preventDefault(); handleArrowClick(-1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); handleArrowClick(1); }
  }

  // Setup
  calculateLayout();
  window.addEventListener('resize', calculateLayout);
  setTranslate(-(currentIndex * CARD_WIDTH));

  // Events
  track!.addEventListener('mousedown', (e) => handleDragStart(e));
  track!.addEventListener('touchstart', (e) => handleDragStart(e));
  document.addEventListener('mousemove', (e) => handleDragMove(e));
  track!.addEventListener('touchmove', (e) => handleDragMove(e));
  document.addEventListener('mouseup', handleDragEnd);
  track!.addEventListener('touchend', handleDragEnd);
  prevBtn?.addEventListener('click', () => handleArrowClick(-1));
  nextBtn?.addEventListener('click', () => handleArrowClick(1));
  document.addEventListener('keydown', handleKeyDown);

  // Image fallback
  const photos = carousel?.querySelectorAll<HTMLImageElement>('.ts__photo img');
  photos?.forEach((img) => {
    const photo = img.closest('.ts__photo') as HTMLElement;
    if (!photo) return;
    const fail = () => photo.classList.add('is-missing');
    img.addEventListener('error', fail);
    if (img.complete && img.naturalWidth === 0) fail();
  });
</script>
